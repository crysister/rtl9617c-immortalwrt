+	path->type = DEV_PATH_IP_TUNNEL;
+	path->dev = ctx->dev;
+	path->ip_tunnel.addr_family = AF_INET6;
+	path->ip_tunnel.proto = IPPROTO_IPIP;
+	memcpy(path->ip_tunnel.ipv6.saddr, &t->parms.laddr, 16);
+	memcpy(path->ip_tunnel.ipv6.daddr, &t->parms.raddr, 16);
+	ether_addr_copy(path->ip_tunnel.h_dest, ha);
+
+	ctx->dev = outdev;
+	dst_release(dst);
+	return 0;
+}
