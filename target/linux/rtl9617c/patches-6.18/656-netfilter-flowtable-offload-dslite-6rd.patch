+static int ip6_tnl_fill_forward_path(struct net_device_path_ctx *ctx,
+				     struct net_device_path *path)
+{
+	const struct ip6_tnl *t = netdev_priv(ctx->dev);
+	struct net_device *outdev;
+	struct neighbour *n;
+	struct dst_entry *dst;
+	struct flowi6 fl6 = {};
+	u8 ha[ETH_ALEN] = {};
+	u8 tproto;
+
+	tproto = READ_ONCE(t->parms.proto);
+	if (t->parms.collect_md || t->encap.type != TUNNEL_ENCAP_NONE ||
+	    t->parms.fmrs || (tproto != IPPROTO_IPIP && tproto != 0) ||
+	    !(t->parms.flags & IP6_TNL_F_CAP_XMIT) ||
+	    !(t->parms.flags & IP6_TNL_F_CAP_RCV) ||
+	    ipv6_addr_any(&t->parms.laddr) ||
+	    ipv6_addr_any(&t->parms.raddr))
+		return -EOPNOTSUPP;
+
+	fl6.saddr = t->parms.laddr;
+	fl6.daddr = t->parms.raddr;
+	fl6.flowi6_oif = t->parms.link;
+	fl6.flowi6_proto = IPPROTO_IPIP;
+	fl6.flowi6_mark = t->parms.fwmark;
+	fl6.flowi6_uid = sock_net_uid(t->net, NULL);
+
+	dst = ip6_route_output(t->net, NULL, &fl6);
+	if (!dst || dst->error) {
+		dst_release(dst);
+		return -ENOENT;
+	}
+
+	outdev = dst->dev;
+	if (!outdev || outdev == ctx->dev || (outdev->flags & IFF_LOOPBACK) ||
+	    dst_xfrm(dst)) {
+		dst_release(dst);
+		return -EOPNOTSUPP;
+	}
+
+	if (outdev->type == ARPHRD_PPP) {
+		if (!outdev->netdev_ops ||
+		    !outdev->netdev_ops->ndo_fill_forward_path) {
+			dst_release(dst);
+			return -EOPNOTSUPP;
+		}
+	} else {
+		const struct in6_addr *nh;
+
+		if (outdev->type != ARPHRD_ETHER ||
+		    outdev->addr_len != ETH_ALEN) {
+			dst_release(dst);
+			return -EOPNOTSUPP;
+		}
