+	path->dev = ctx->dev;
+	path->ip_tunnel.addr_family = AF_INET;
+	path->ip_tunnel.proto = IPPROTO_IPV6;
+	path->ip_tunnel.ipv4.saddr = tiph->saddr;
+	path->ip_tunnel.ipv4.daddr = tiph->daddr;
+	ether_addr_copy(path->ip_tunnel.h_dest, ha);
