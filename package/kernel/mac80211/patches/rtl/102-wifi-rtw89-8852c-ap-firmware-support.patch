-			rtw8852c_bw_setting(rtwdev, bw, RF_PATH_B);
+		if (rtw89_is_ap_fw(rtwdev)) {
+			rtw8852c_adc_cfg(rtwdev, bw, RF_PATH_A);
+			if (!rtwdev->dbcc_en)
+				rtw8852c_adc_cfg(rtwdev, bw, RF_PATH_B);
+		} else {
+			rtw8852c_bw_setting(rtwdev, bw, RF_PATH_A);
+			if (!rtwdev->dbcc_en)
+				rtw8852c_bw_setting(rtwdev, bw, RF_PATH_B);
+		}
 	} else {
-		rtw8852c_bw_setting(rtwdev, bw, RF_PATH_B);
+		if (rtw89_is_ap_fw(rtwdev))
+			rtw8852c_adc_cfg(rtwdev, bw, RF_PATH_B);
+		else
+			rtw8852c_bw_setting(rtwdev, bw, RF_PATH_B);
 	}
 
 	rtw8852c_edcca_per20_bitmap_sifs(rtwdev, bw, phy_idx);
@@ -1755,6 +1976,32 @@ void rtw8852c_bb_gpio_rfm(struct rtw89_d
 	rtw89_phy_write32_mask(rtwdev, cr, mask, val);
 }
 
+static void rtw8852c_bb_gpio_rfm_init(struct rtw89_dev *rtwdev)
+{
+	static const u32 rfm_bases[] = {0x5894, 0x7894};
+	u8 pape = 0x0, trsw = 0x4, lnaon = 0x8;
+	u8 rfe_type = rtwdev->efuse.rfe_type;
+	enum rtw89_rf_path path;
+
+	if (rtw8852c_ap_efem(rtwdev)) {
+		pape = 0x4;
+		trsw = 0x6;
+		if (rfe_type == 53 || rfe_type == 54 ||
+		    rfe_type == 63 || rfe_type == 64)
+			lnaon = 0xA;
+
+		for (path = RF_PATH_A; path < ARRAY_SIZE(rfm_bases); path++)
+			rtw89_phy_write32_set(rtwdev, rfm_bases[path],
+					      B_P0_RFM_TRSW_SEL);
+	}
+
+	for (path = RF_PATH_A; path <= RF_PATH_B; path++) {
+		rtw8852c_bb_gpio_rfm(rtwdev, path, PAPE_RFM, 0, 0, 0, pape);
+		rtw8852c_bb_gpio_rfm(rtwdev, path, TRSW_RFM, 0, 0, 0, trsw);
+		rtw8852c_bb_gpio_rfm(rtwdev, path, LNAON_RFM, 0, 0, 0, lnaon);
+	}
+}
+
 static void rtw8852c_bb_gpio_init(struct rtw89_dev *rtwdev)
 {
 	static const u32 cr_bases[] = {0x5800, 0x7800};
@@ -1793,13 +2040,37 @@ static void rtw8852c_bb_gpio_init(struct
 	rtw8852c_bb_gpio_trsw(rtwdev, RF_PATH_B, 1, 1, 0, 1, 0);
 	rtw8852c_bb_gpio_trsw(rtwdev, RF_PATH_B, 1, 1, 1, 1, 0);
 
-	rtw8852c_bb_gpio_rfm(rtwdev, RF_PATH_A, PAPE_RFM, 0, 0, 0, 0x0);
-	rtw8852c_bb_gpio_rfm(rtwdev, RF_PATH_A, TRSW_RFM, 0, 0, 0, 0x4);
-	rtw8852c_bb_gpio_rfm(rtwdev, RF_PATH_A, LNAON_RFM, 0, 0, 0, 0x8);
-
-	rtw8852c_bb_gpio_rfm(rtwdev, RF_PATH_B, PAPE_RFM, 0, 0, 0, 0x0);
-	rtw8852c_bb_gpio_rfm(rtwdev, RF_PATH_B, TRSW_RFM, 0, 0, 0, 0x4);
-	rtw8852c_bb_gpio_rfm(rtwdev, RF_PATH_B, LNAON_RFM, 0, 0, 0, 0x8);
+	rtw8852c_bb_gpio_rfm_init(rtwdev);
+}
