+static void rtw8852c_adc_cfg(struct rtw89_dev *rtwdev, u8 bw, u8 path)
+{
+	static const u32 idac2[2] = {0xC0D4, 0xC1D4};
+	static const u32 bw_sel[2] = {0xC0D8, 0xC1D8};
+	static const u32 rck_ofst[2] = {0xC0C4, 0xC1C4};
+	static const u32 rck_cnt[2] = {0xC0E8, 0xC1E8};
+	static const u32 wbadc_sel[2] = {0xC0E4, 0xC1E4};
+	static const u32 rx_adc_clk[2] = {0x12A0, 0x32A0};
+	static const u32 adc_ec[2] = {0xC0EC, 0xC1EC};
+	static const u32 upd_clk_adc[2] = {0x566C, 0x766C};
+	static const u32 agc_rst_l[2] = {0x4BE8, 0x4CAC};
+	static const u32 agc_rst_bw[2] = {0x4BE4, 0x4CA8};
+	u32 rst_cycle = 0x3;
+	u32 agc_th;
+
+	rtw89_phy_write32_mask(rtwdev, idac2[path], 0x780, 0x8);
+	rtw89_phy_write32_mask(rtwdev, rck_cnt[path], 0xFFFF0000, 0x9);
+	rtw89_phy_write32_mask(rtwdev, wbadc_sel[path], 0x30, 0x2);
+	rtw89_phy_write32_mask(rtwdev, rx_adc_clk[path], 0xFF800000, 0x49);
+	rtw89_phy_write32_mask(rtwdev, adc_ec[path], 0x6000, 0x0);
+
+	switch (bw) {
+	case RTW89_CHANNEL_WIDTH_5:
+	case RTW89_CHANNEL_WIDTH_10:
+	case RTW89_CHANNEL_WIDTH_20:
+	case RTW89_CHANNEL_WIDTH_40:
+		rtw89_phy_write32_mask(rtwdev, idac2[path], 0x7800, 0x2);
+		rtw89_phy_write32_mask(rtwdev, idac2[path], 0x0C000000, 0x3);
+		rtw89_phy_write32_mask(rtwdev, bw_sel[path], 0x1E0, 0xf);
+		rtw89_phy_write32_mask(rtwdev, rck_ofst[path], 0x3E0000, 0x0);
+		rtw89_phy_write32_mask(rtwdev, upd_clk_adc[path], GENMASK(17, 16), 0);
+		if (rtwdev->efuse.rfe_type >= 51)
+			rst_cycle = 0x2;
+		rtw89_phy_write32_mask(rtwdev, adc_ec[path], 0xFF0000, rst_cycle);
+		agc_th = rtw89_phy_read32_mask(rtwdev, agc_rst_bw[path],
+					       bw == RTW89_CHANNEL_WIDTH_40 ?
+					       0x07800000 : 0x00780000);
+		rtw89_phy_write32_mask(rtwdev, agc_rst_l[path], 0xf, agc_th);
+		break;
+	case RTW89_CHANNEL_WIDTH_80:
+		rtw89_phy_write32_mask(rtwdev, idac2[path], 0x7800, 0x2);
+		rtw89_phy_write32_mask(rtwdev, idac2[path], 0x0C000000, 0x2);
+		rtw89_phy_write32_mask(rtwdev, bw_sel[path], 0x1E0, 0x8);
+		rtw89_phy_write32_mask(rtwdev, rck_ofst[path], 0x3E0000, 0x0);
+		rtw89_phy_write32_mask(rtwdev, adc_ec[path], 0xFF0000, 0x3);
+		rtw89_phy_write32_mask(rtwdev, upd_clk_adc[path], GENMASK(17, 16), 1);
+		agc_th = rtw89_phy_read32_mask(rtwdev, agc_rst_bw[path], 0x78000000);
+		rtw89_phy_write32_mask(rtwdev, agc_rst_l[path], 0xf, agc_th);
+		break;
+	case RTW89_CHANNEL_WIDTH_160:
+		rtw89_phy_write32_mask(rtwdev, idac2[path], 0x7800, 0x0);
+		rtw89_phy_write32_mask(rtwdev, idac2[path], 0x0C000000, 0x2);
+		rtw89_phy_write32_mask(rtwdev, bw_sel[path], 0x1E0, 0x4);
+		rtw89_phy_write32_mask(rtwdev, rck_ofst[path], 0x3E0000, 0x6);
+		rtw89_phy_write32_mask(rtwdev, adc_ec[path], 0xFF0000, 0x3);
+		rtw89_phy_write32_mask(rtwdev, upd_clk_adc[path], GENMASK(17, 16), 2);
+		agc_th = rtw89_phy_read32_mask(rtwdev, agc_rst_bw[path], 0x00078000);
+		rtw89_phy_write32_mask(rtwdev, agc_rst_l[path], 0xf, agc_th);
+		break;
+	default:
+		break;
+	}
+}
+
 static void rtw8852c_bw_setting(struct rtw89_dev *rtwdev, u8 bw, u8 path)
 {
 	static const u32 adc_sel[2] = {0xC0EC, 0xC1EC};
@@ -1375,11 +1587,20 @@ rtw8852c_ctrl_bw(struct rtw89_dev *rtwde
 	}
 
 	if (phy_idx == RTW89_PHY_0) {
-		rtw8852c_bw_setting(rtwdev, bw, RF_PATH_A);
