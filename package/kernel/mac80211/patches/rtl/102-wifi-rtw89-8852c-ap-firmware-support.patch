+static void _tssi_alimentk_efem(struct rtw89_dev *rtwdev,
+				enum rtw89_rf_path path,
+				const struct rtw89_chan *chan)
+{
+	static const s16 pwr_2g[4] = {32, 4, 8, -8};
+	static const s16 pwr_5g[4] = {52, 24, 8, -8};
+	static const u32 bb_bkup_reg[4] = {0x12b8, 0x32b8, 0x030c, 0x032c};
+	const s16 *pwr = chan->band_type == RTW89_BAND_2G ? pwr_2g : pwr_5g;
+	u32 bb_bkup[4] = {};
+	u32 ofst = path << 13;
+	u32 cw[4] = {};
+	s32 corr;
+	int i, ret = 0;
+
+	if (chan->band_type != RTW89_BAND_2G) {
+		for (i = 0; i < ARRAY_SIZE(bb_bkup_reg); i++)
+			bb_bkup[i] = rtw89_phy_read32(rtwdev, bb_bkup_reg[i]);
+		rtw89_phy_write32_mask(rtwdev, 0x12b8, BIT(30), 0x1);
+		rtw89_phy_write32_mask(rtwdev, 0x32b8, BIT(30), 0x1);
+		rtw89_phy_write32_mask(rtwdev, 0x030c, 0xff000000, 0x1f);
+		rtw89_phy_write32_mask(rtwdev, 0x030c, 0xff000000, 0x13);
+		rtw89_phy_write32_mask(rtwdev, 0x032c, 0xffff0000, 0x0001);
+		rtw89_phy_write32_mask(rtwdev, 0x032c, 0xffff0000, 0x0041);
+	}
+
+	rtw89_phy_write32_mask(rtwdev, 0x2008, 0x01ffffff, 0xfffff);
+	rtw89_phy_write32_mask(rtwdev, 0x5688 + ofst, 0x03ff0000, 0x3a1);
+	rtw89_phy_write32_mask(rtwdev, 0x5680 + ofst, 0x000ffff0, 0x0);
+	rtw89_phy_write32_mask(rtwdev, 0x5680 + ofst, 0x07f00000, 0x7f);
+	rtw89_phy_write32_mask(rtwdev, 0x5680 + ofst, 0xf0000000, 0x2);
+	rtw89_phy_write32_mask(rtwdev, 0x5680 + ofst, BIT(27), 0x0);
+	rtw89_phy_write32_mask(rtwdev, 0x5684 + ofst, 0x7f, 0x1);
+	rtw89_phy_write32_mask(rtwdev, 0x5684 + ofst, 0x007f0000, 0x8);
+	rtw89_phy_write32_mask(rtwdev, 0x5688 + ofst, BIT(30), 0x1);
+	rtw89_phy_write32_mask(rtwdev, 0x120c + ofst, 0xf000, 0x1);
+	rtw89_phy_write32_mask(rtwdev, 0x56cc + ofst, BIT(28), 0x1);
+	rtw89_phy_write32_mask(rtwdev, 0x56cc + ofst, 0x0ff80000, pwr[0] & 0x1ff);
+	rtw89_phy_write32_mask(rtwdev, 0x5864 + ofst, BIT(27), 0x0);
+	rtw89_phy_write32_mask(rtwdev, 0x5680 + ofst, BIT(2), 0x1);
+	rtw89_phy_write32_mask(rtwdev, 0x5680 + ofst, BIT(2), 0x0);
+	fsleep(2000);
+
+	for (i = 0; i < 4; i++) {
+		if (i)
+			rtw89_phy_write32_mask(rtwdev, 0x56cc + ofst, 0x0ff80000,
+					       pwr[i] & 0x1ff);
+		ret = _tssi_alimentk_measure(rtwdev, path, &cw[i]);
+		if (ret)
