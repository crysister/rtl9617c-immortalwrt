+static void _txgapk_one_shot(struct rtw89_dev *rtwdev, u8 path, u32 cmd)
+{
+	u32 val;
+
+	if (rtw89_phy_read32_mask(rtwdev, 0xbff8, MASKBYTE0)) {
+		rtw89_phy_write32_mask(rtwdev, 0x8010, MASKBYTE0, 0x0);
+		udelay(1);
+	}
+
+	rtw89_phy_write32(rtwdev, 0x8000, cmd + (path << 4));
+	read_poll_timeout_atomic(rtw89_phy_read32_mask, val, val == 0x55,
+				 10, 20000, false, rtwdev, 0xbff8, MASKBYTE0);
+	udelay(1);
+	read_poll_timeout_atomic(rtw89_phy_read32_mask, val, val == 0x8000,
+				 1, 2000, false, rtwdev, 0x80fc, MASKLWORD);
+	udelay(1);
+	rtw89_phy_write32_mask(rtwdev, 0x8010, MASKBYTE0, 0x0);
+}
