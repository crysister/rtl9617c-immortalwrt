+		if (i == 1) {
+			corr = (s32)cw[0] - (s32)cw[1] - (pwr[0] - pwr[1]) * 2;
+			_tssi_alimentk_correct(rtwdev, path, 0x5638, 0x3ff, corr);
+			_tssi_alimentk_correct(rtwdev, path, 0x5644, 0x3ff, corr);
+		} else if (i == 3) {
+			corr = (s32)cw[2] - (s32)cw[3] - (pwr[2] - pwr[3]) * 2;
+			_tssi_alimentk_correct(rtwdev, path, 0x5634, 0x3ff00000, corr);
+			_tssi_alimentk_correct(rtwdev, path, 0x5640, 0x3ff00000, corr);
+			_tssi_alimentk_correct(rtwdev, path, 0x5634, 0x000ffc00, corr);
+			_tssi_alimentk_correct(rtwdev, path, 0x5640, 0x000ffc00, corr);
+		}
+	}
+
+	rtw89_phy_write32_mask(rtwdev, 0x5680 + ofst, BIT(3), 0x0);
+	rtw89_phy_write32_mask(rtwdev, 0x5684 + ofst, BIT(7), 0x1);
+	rtw89_phy_write32_mask(rtwdev, 0x5684 + ofst, BIT(7), 0x0);
+	rtw89_phy_write32_mask(rtwdev, 0x5864 + ofst, BIT(27), 0x1);
+	rtw89_phy_write32_mask(rtwdev, 0x56cc + ofst, BIT(28), 0x0);
+	rtw89_phy_write32_mask(rtwdev, 0x033c, 0xff000000, 0x1f);
+	rtw89_phy_write32_mask(rtwdev, 0x023c, 0xffff0000, 0x2001);
+	rtw89_phy_write32_mask(rtwdev, 0x5670 + ofst, BIT(0), 0x1);
+	rtw89_phy_write32_mask(rtwdev, 0x02fc, BIT(16 + path), 0x1);
+	rtw89_phy_write32_mask(rtwdev, 0x02fc, BIT(20 + path), 0x0);
+	rtw89_phy_write32_mask(rtwdev, 0x023c, 0xffff0000, 0x2001);
+	rtw89_phy_write32_mask(rtwdev, 0x5670 + ofst, BIT(0), 0x1);
+	rtw89_phy_write32_mask(rtwdev, 0x02fc, BIT(16 + path), 0x1);
+	rtw89_phy_write32_mask(rtwdev, 0x02fc, BIT(20 + path), 0x0);
+	rtw89_phy_write32_mask(rtwdev, 0x5670 + ofst, BIT(0), 0x0);
+	rtw89_phy_write32_mask(rtwdev, 0x02fc, BIT(16 + path), 0x0);
+
+	if (chan->band_type != RTW89_BAND_2G) {
+		for (i = 0; i < ARRAY_SIZE(bb_bkup_reg); i++)
+			rtw89_phy_write32(rtwdev, bb_bkup_reg[i], bb_bkup[i]);
+	}
+}
