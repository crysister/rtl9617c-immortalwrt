+static void rtw8852c_set_gain_efem(struct rtw89_dev *rtwdev, u8 gain_band,
+				   enum rtw89_rf_path path)
+{
+	static const u32 wb_gidx_elna[BB_PATH_NUM_8852C] = {0x4734, 0x4AA0};
+	static const u32 wb_gidx_lna_tia[BB_PATH_NUM_8852C][4] = {
+		{0x46A0, 0x46BC, 0x4720, 0x4724},
+		{0x49F4, 0x4A70, 0x4A74, 0x4A78},
+	};
+	static const u32 gs_idx[BB_PATH_NUM_8852C][2] = {
+		{0x46A8, 0x46AC}, {0x4A5C, 0x4A60},
+	};
+	static const u32 g_elna[BB_PATH_NUM_8852C] = {0x45DC, 0x4740};
+	const struct rtw89_phy_bb_gain_info *gain = &rtwdev->bb_gain.ax;
+	const u8 *lna_tia = gain->wb_gidx_lna_tia[gain_band][path];
+	u32 val;
+	int i;
+
+	rtw89_phy_write32_mask(rtwdev, wb_gidx_elna[path], 0x3fffc0,
+			       gain->wb_gidx_elna[gain_band][path]);
+
+	rtw89_phy_write32_mask(rtwdev, wb_gidx_lna_tia[path][0], 0xE0000000,
+			       lna_tia[0]);
+
+	val = lna_tia[2] << 3 | lna_tia[1];
+	rtw89_phy_write32_mask(rtwdev, wb_gidx_lna_tia[path][1], 0x3F000000, val);
+
+	for (val = 0, i = 0; i < 10; i++)
+		val |= lna_tia[i + 3] << (3 * i);
+	rtw89_phy_write32_mask(rtwdev, wb_gidx_lna_tia[path][2], 0x3FFFFFFF, val);
+
+	val = lna_tia[15] << 6 | lna_tia[14] << 3 | lna_tia[13];
+	rtw89_phy_write32_mask(rtwdev, wb_gidx_lna_tia[path][3], 0x1FF, val);
+
+	val = gain->gs_idx[gain_band][path][0] & 0xffff;
+	rtw89_phy_write32_mask(rtwdev, gs_idx[path][0], 0x7FFF8000, val);
+
+	val = gain->gs_idx[gain_band][path][1] << 16 |
+	      gain->gs_idx[gain_band][path][0] >> 16;
+	rtw89_phy_write32_mask(rtwdev, gs_idx[path][1], 0x0FFFFFFF, val);
+
+	val = gain->g_elna[gain_band][path][1] << 8 |
+	      gain->g_elna[gain_band][path][0];
+	rtw89_phy_write32_mask(rtwdev, g_elna[path], 0xFFFF, val);
+}
+
 static void rtw8852c_set_gain_error(struct rtw89_dev *rtwdev,
 				    enum rtw89_subband subband,
 				    enum rtw89_rf_path path)
@@ -1059,6 +1191,9 @@ static void rtw8852c_set_gain_error(stru
