+static void _tssi_alimentk_correct(struct rtw89_dev *rtwdev,
+				   enum rtw89_rf_path path, u32 addr,
+				   u32 mask, s32 corr)
+{
+	u32 reg = addr + (path << 13);
+	s32 val;
+
+	val = sign_extend32(rtw89_phy_read32_mask(rtwdev, reg, mask), 9) + corr;
+	val = clamp(val, -512, 511);
+	rtw89_phy_write32_mask(rtwdev, reg, mask, val & 0x3ff);
+}
+
+static int _tssi_alimentk_measure(struct rtw89_dev *rtwdev,
+				  enum rtw89_rf_path path, u32 *cw)
+{
+	u32 ofst = path << 13;
+	u32 val;
+	int ret;
+
+	rtw89_phy_write32_mask(rtwdev, 0x5820 + ofst, BIT(31), 0x0);
+	rtw89_phy_write32_mask(rtwdev, 0x5820 + ofst, BIT(31), 0x1);
+	fsleep(100);
+
+	ret = read_poll_timeout(rtw89_phy_read32, val, val & BIT(16),
+				500, 5000, false, rtwdev, 0x1c18 + ofst);
+	if (ret)
+		return ret;
+
+	*cw = rtw89_phy_read32(rtwdev, 0x1c18 + ofst) & 0x3ff;
+	return 0;
+}
