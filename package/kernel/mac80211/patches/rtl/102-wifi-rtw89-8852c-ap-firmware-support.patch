+static void rtw8852c_fem_setup(struct rtw89_dev *rtwdev)
+{
+	struct rtw89_fem_info *fem = &rtwdev->fem;
+
+	if (!rtw8852c_ap_efem(rtwdev))
+		return;
+
+	fem->epa_2g = true;
+	fem->elna_2g = true;
+	fem->epa_5g = true;
+	fem->elna_5g = true;
+}
