+		return 4;
+	case 113 ... 115:
+		return RTW8192XB_TSSI_EXTRA_GROUP(4);
+	case 116 ... 128:
+		return 5;
+	case 132 ... 144:
+		return 6;
+	case 149 ... 177:
+		return 7;
+	default:
+		return 0;
+	}
+}
+
+static s8 rtw8192xb_tssi_get_ofdm_de(struct rtw89_dev *rtwdev,
+				     enum rtw89_rf_path path, u8 ch)
+{
+	struct rtw89_tssi_info *tssi_info = &rtwdev->tssi;
+	u32 gidx = rtw8192xb_tssi_get_ofdm_group(ch);
+
+	if (RTW8192XB_IS_TSSI_EXTRA(gidx)) {
+		u32 idx1 = RTW8192XB_TSSI_EXTRA_IDX1(gidx);
+		u32 idx2 = RTW8192XB_TSSI_EXTRA_IDX2(gidx);
+
+		return (tssi_info->tssi_mcs[path][idx1] +
+			tssi_info->tssi_mcs[path][idx2]) / 2;
+	}
+
+	return tssi_info->tssi_mcs[path][gidx];
+}
+
+static s8 rtw8192xb_tssi_get_trim_de(struct rtw89_dev *rtwdev,
+				     enum rtw89_rf_path path, u8 ch)
+{
+	struct rtw89_tssi_info *tssi_info = &rtwdev->tssi;
+	u32 gidx = rtw8192xb_tssi_get_trim_group(ch);
+
+	if (RTW8192XB_IS_TSSI_EXTRA(gidx)) {
+		u32 idx1 = RTW8192XB_TSSI_EXTRA_IDX1(gidx);
+		u32 idx2 = RTW8192XB_TSSI_EXTRA_IDX2(gidx);
+
+		return (tssi_info->tssi_trim[path][idx1] +
+			tssi_info->tssi_trim[path][idx2]) / 2;
+	}
+
+	return tssi_info->tssi_trim[path][gidx];
+}
+
+static void rtw8192xb_tssi_set_efuse_to_de(struct rtw89_dev *rtwdev,
+					   const struct rtw89_chan *chan)
+{
+	struct rtw89_tssi_info *tssi_info = &rtwdev->tssi;
+	u8 ch = chan->channel;
+	u32 cck_gidx = rtw8192xb_tssi_get_cck_group(ch);
+	u8 path;
+
+	for (path = RF_PATH_A; path < RF_PATH_NUM_8192XB; path++) {
+		u32 p13 = path << 13;
+		s8 trim_de = rtw8192xb_tssi_get_trim_de(rtwdev, path, ch);
+		s32 cck_val = tssi_info->tssi_cck[path][cck_gidx] + trim_de;
+		s32 ofdm_val = rtw8192xb_tssi_get_ofdm_de(rtwdev, path, ch) + trim_de;
+		u32 cck_reg = (u32)(cck_val & 0x3ff);
+		u32 ofdm_reg = (u32)(ofdm_val & 0x3ff);
+
+		rtw89_phy_write32_mask(rtwdev, 0x5858 + p13, RTW8192XB_TSSI_DE_MASK, cck_reg);
+		rtw89_phy_write32_mask(rtwdev, 0x5860 + p13, RTW8192XB_TSSI_DE_MASK, cck_reg);
+
+		rtw89_phy_write32_mask(rtwdev, 0x5838 + p13, RTW8192XB_TSSI_DE_MASK, ofdm_reg);
+		rtw89_phy_write32_mask(rtwdev, 0x5840 + p13, RTW8192XB_TSSI_DE_MASK, ofdm_reg);
+		rtw89_phy_write32_mask(rtwdev, 0x5848 + p13, RTW8192XB_TSSI_DE_MASK, ofdm_reg);
+		rtw89_phy_write32_mask(rtwdev, 0x5850 + p13, RTW8192XB_TSSI_DE_MASK, ofdm_reg);
+		rtw89_phy_write32_mask(rtwdev, 0x5828 + p13, RTW8192XB_TSSI_DE_MASK, ofdm_reg);
+		rtw89_phy_write32_mask(rtwdev, 0x5830 + p13, RTW8192XB_TSSI_DE_MASK, ofdm_reg);
+	}
+}
+
+void rtw8192xb_tssi(struct rtw89_dev *rtwdev, enum rtw89_phy_idx phy_idx,
+		    enum rtw89_chanctx_idx chanctx_idx)
+{
+	const struct rtw89_chan *chan = rtw89_chan_get(rtwdev, chanctx_idx);
+	u8 path;
+
+	rtw8192xb_tssi_disable(rtwdev);
+
+	for (path = RF_PATH_A; path < RF_PATH_NUM_8192XB; path++) {
+		rtw8192xb_tssi_set_sys(rtwdev, path);
+		rtw8192xb_tssi_ini_txpwr_ctrl_bb(rtwdev, path);
+		rtw8192xb_tssi_ini_txpwr_ctrl_bb_he_tb(rtwdev, path);
+		rtw8192xb_tssi_set_dck(rtwdev, path);
+		rtw8192xb_tssi_set_bbgain_split(rtwdev, path);
+		rtw8192xb_tssi_set_tmeter_tbl(rtwdev, path, chan);
+		rtw8192xb_tssi_slope_cal_org(rtwdev, path);
+		rtw8192xb_tssi_set_alignment_default(rtwdev, path);
+		rtw8192xb_tssi_set_slope(rtwdev, path);
+		rtw8192xb_tssi_run_slope(rtwdev, path);
+	}
+
+	rtw8192xb_tssi_enable(rtwdev);
+	rtw8192xb_tssi_set_efuse_to_de(rtwdev, chan);
+}
+
+void rtw8192xb_tssi_scan(struct rtw89_dev *rtwdev, enum rtw89_phy_idx phy_idx,
+			 const struct rtw89_chan *chan)
+{
+	u8 path;
+
+	if (!rtwdev->is_tssi_mode[RF_PATH_A] && !rtwdev->is_tssi_mode[RF_PATH_B])
+		return;
+
+	rtw8192xb_tssi_set_efuse_to_de(rtwdev, chan);
+
+	for (path = RF_PATH_A; path < RF_PATH_NUM_8192XB; path++) {
+		u32 p13 = path << 13;
+
+		rtw89_phy_write32_mask(rtwdev, 0x5820 + p13, BIT(31), 0x0);
+		rtw89_phy_write32_mask(rtwdev, 0x5820 + p13, BIT(31), 0x1);
+		rtw89_phy_write32_mask(rtwdev, 0x5818 + p13, BIT(28), 0x0);
+		rtw89_phy_write32_mask(rtwdev, 0x5818 + p13, BIT(28), 0x1);
+	}
+}
+
+void rtw8192xb_tssi_cont_en_phyidx(struct rtw89_dev *rtwdev, bool en,
+				   enum rtw89_phy_idx phy_idx,
+				   const struct rtw89_chan *chan)
+{
+	u8 path;
+
+	for (path = RF_PATH_A; path < RF_PATH_NUM_8192XB; path++) {
+		if (rtwdev->dbcc_en && phy_idx == RTW89_PHY_0 && path == RF_PATH_B)
+			continue;
+		if (rtwdev->dbcc_en && phy_idx == RTW89_PHY_1 && path == RF_PATH_A)
+			continue;
+
+		rtw89_phy_write32_mask(rtwdev, 0x5818 + (path << 13),
+				       BIT(30), en ? 0x0 : 0x1);
+	}
+
+	if (en && (rtwdev->is_tssi_mode[RF_PATH_A] || rtwdev->is_tssi_mode[RF_PATH_B]))
+		rtw8192xb_tssi_set_efuse_to_de(rtwdev, chan);
+}
+
+void rtw8192xb_tssi_track(struct rtw89_dev *rtwdev)
+{
+	if (!rtwdev->is_tssi_mode[RF_PATH_A] && !rtwdev->is_tssi_mode[RF_PATH_B])
+		return;
+
+	if (rtw89_phy_read32_mask(rtwdev, 0x1c60, 0xff000000) == 0x7f ||
+	    rtw89_phy_read32_mask(rtwdev, 0x3c60, 0xff000000) == 0x7f) {
+		rtw8192xb_tssi_disable(rtwdev);
+		rtw8192xb_tssi_enable(rtwdev);
+	}
+}
+
+void rtw8192xb_wifi_scan_notify(struct rtw89_dev *rtwdev, bool scan_start,
+				enum rtw89_phy_idx phy_idx)
+{
+	u8 path;
+
+	if (scan_start)
+		return;
+
+	if (!rtwdev->is_tssi_mode[RF_PATH_A] && !rtwdev->is_tssi_mode[RF_PATH_B])
+		return;
+
+	for (path = RF_PATH_A; path < RF_PATH_NUM_8192XB; path++) {
+		u32 p13 = path << 13;
+
+		rtw89_phy_write32_mask(rtwdev, 0x5818 + p13, BIT(28), 0x0);
+		rtw89_phy_write32_mask(rtwdev, 0x5818 + p13, BIT(28), 0x1);
+	}
+}
+
+void rtw8192xb_dpk_init(struct rtw89_dev *rtwdev)
+{
+	struct rtw89_dpk_info *dpk = &rtwdev->dpk;
+
+	memset(dpk, 0, sizeof(*dpk));
+	dpk->is_dpk_enable = true;
+	dpk->is_dpk_reload_en = false;
+
+	rtw89_mac_txpwr_write32_mask(rtwdev, RTW89_PHY_0, 0xd22c, 0x1f800000, 0x29);
+	rtw89_mac_txpwr_write32_mask(rtwdev, RTW89_PHY_0, 0xd230, 0x0003ffff, 0x24924);
+}
+
+static void rtw8192xb_dpk_onoff(struct rtw89_dev *rtwdev,
+				enum rtw89_rf_path path, bool off)
+{
+	struct rtw89_dpk_info *dpk = &rtwdev->dpk;
+	u8 kidx = dpk->cur_idx[path];
+	u8 val;
+
+	val = dpk->is_dpk_enable && !off && dpk->bp[path][kidx].path_ok;
+	rtw89_phy_write32_mask(rtwdev, 0x81bc + (path << 8) + (kidx << 2),
+			       0xf0000000, val);
+}
+
+static bool rtw8192xb_dpk_bypass_check(struct rtw89_dev *rtwdev,
+				       const struct rtw89_chan *chan)
+{
+	if (chan->band_type == RTW89_BAND_5G || rtwdev->fem.epa_2g ||
+	    rtw8192xb_rfk_is_efem(rtwdev))
+		return true;
+
+	return false;
+}
+
+void rtw8192xb_dpk(struct rtw89_dev *rtwdev, enum rtw89_phy_idx phy_idx,
+		   enum rtw89_chanctx_idx chanctx_idx)
+{
+	const struct rtw89_chan *chan = rtw89_chan_get(rtwdev, chanctx_idx);
+	u8 path;
+
+	if (rtw8192xb_dpk_bypass_check(rtwdev, chan)) {
+		for (path = RF_PATH_A; path < RF_PATH_NUM_8192XB; path++)
+			rtw8192xb_dpk_onoff(rtwdev, path, true);
+	}
+}
+
+void rtw8192xb_dpk_track(struct rtw89_dev *rtwdev)
+{
+	struct rtw89_dpk_info *dpk = &rtwdev->dpk;
+	u8 path, kidx, txagc_rf, cur_ther;
+	s8 delta_ther;
+
+	if (rtwdev->scanning)
+		return;
+
+	for (path = RF_PATH_A; path < RF_PATH_NUM_8192XB; path++) {
+		kidx = dpk->cur_idx[path];
+		if (!dpk->bp[path][kidx].path_ok)
+			continue;
+
+		txagc_rf = rtw89_phy_read32_mask(rtwdev, 0x1c60 + (path << 13), 0x3f);
+		if (!txagc_rf)
+			continue;
+
+		rtw89_phy_write32(rtwdev, 0x81d4 + (path << 8), 0xf0000);
+		cur_ther = rtw89_phy_read32_mask(rtwdev, 0x81fc + (path << 8), 0x3f);
+		delta_ther = (s8)(cur_ther - dpk->bp[path][kidx].ther_dpk) / 2;
+
+		if (rtw89_phy_read32_mask(rtwdev, 0x80f0, BIT(29)) == 0x0)
+			rtw89_phy_write32_mask(rtwdev,
+					       0x81b4 + (path << 8) + (kidx << 2),
+					       0x07fc0000, 0x76 - delta_ther);
+	}
+}
+
+void rtw8192xb_op5k_init(struct rtw89_dev *rtwdev)
+{
+	struct rtw89_op5k_info *op5k = &rtwdev->op5k;
+
+	memset(op5k, 0, sizeof(*op5k));
+	if (rtwdev->hal.cv == CHIP_CAV)
+		return;
+
+	op5k->thermal_base_op5k[RF_PATH_A] = RTW8192XB_OP5K_THER_BASE;
+	op5k->thermal_base_op5k[RF_PATH_B] = RTW8192XB_OP5K_THER_BASE;
+	op5k->thermal_op5k[RF_PATH_A] = RTW8192XB_OP5K_THER_BASE;
+	op5k->thermal_op5k[RF_PATH_B] = RTW8192XB_OP5K_THER_BASE;
+}
+
+void rtw8192xb_op5k_bw_setting(struct rtw89_dev *rtwdev)
+{
+	struct rtw89_op5k_info *op5k = &rtwdev->op5k;
+
+	if (rtwdev->hal.cv == CHIP_CAV)
+		return;
+
+	op5k->op5k_default[RF_PATH_A] = rtw89_phy_read32_mask(rtwdev, 0xc0d8, 0x000001e0);
+	op5k->op5k_default[RF_PATH_B] = rtw89_phy_read32_mask(rtwdev, 0xc1d8, 0x000001e0);
+	op5k->op5k_set_ch_chk = true;
+
+	if (op5k->op5k_ther_chk) {
+		rtw89_phy_write32_mask(rtwdev, 0xc0d8, 0x000001e0,
+				       op5k->rst_cnt_final[RF_PATH_A] & 0xf);
+		rtw89_phy_write32_mask(rtwdev, 0xc1d8, 0x000001e0,
+				       op5k->rst_cnt_final[RF_PATH_B] & 0xf);
+	}
+}
+
+static void rtw8192xb_op5k_reset_cnt(struct rtw89_dev *rtwdev)
+{
+	rtw89_phy_write32_mask(rtwdev, 0x030c, 0xff000000, 0xf);
+	udelay(1);
+	rtw89_phy_write32_mask(rtwdev, 0x030c, 0xff000000, 0x3);
+	rtw89_phy_write32_mask(rtwdev, 0x032c, 0xffff0000, 0x0);
+	udelay(1);
+	rtw89_phy_write32_mask(rtwdev, 0x032c, 0xffff0000, 0x40);
+	rtw89_phy_write32_mask(rtwdev, 0xc0f8, 0x00000006, 0x3);
+	rtw89_phy_write32_mask(rtwdev, 0xc1f8, 0x00000006, 0x3);
+	udelay(1);
+	rtw89_phy_write32_mask(rtwdev, 0xc0f8, 0x00000006, 0x2);
+	rtw89_phy_write32_mask(rtwdev, 0xc1f8, 0x00000006, 0x2);
+	udelay(1);
+}
+
+static void rtw8192xb_op5k_trigger(struct rtw89_dev *rtwdev)
+{
+	struct rtw89_op5k_info *op5k = &rtwdev->op5k;
+	u32 zero_rst_cnt[RF_PATH_NUM_8192XB][RTW89_OP5K_RESET_CNT_DATA];
+	u32 zero_start[RF_PATH_NUM_8192XB][RTW89_OP5K_RESET_CNT_DATA];
+	u32 zero_end[RF_PATH_NUM_8192XB][RTW89_OP5K_RESET_CNT_DATA];
+	u32 max_zero[RF_PATH_NUM_8192XB];
+	u32 max_zero_idx[RF_PATH_NUM_8192XB];
+	u32 retry[RF_PATH_NUM_8192XB] = {0};
+	u32 i, j, k;
+
+	if (rtwdev->hal.cv == CHIP_CAV || op5k->op5k_progress)
+		return;
+
+	op5k->op5k_progress = true;
+
+	while (retry[RF_PATH_A] < 2 || retry[RF_PATH_B] < 2) {
+		memset(op5k->rst_cnt, 0, sizeof(op5k->rst_cnt));
+		memset(op5k->rst_cnt_zero, 0, sizeof(op5k->rst_cnt_zero));
+		memset(op5k->rst_cnt_final, 0, sizeof(op5k->rst_cnt_final));
+		memset(op5k->op5k_backup, 0, sizeof(op5k->op5k_backup));
+		memset(zero_rst_cnt, 0, sizeof(zero_rst_cnt));
+		memset(zero_start, 0, sizeof(zero_start));
+		memset(zero_end, 0, sizeof(zero_end));
+		memset(max_zero, 0, sizeof(max_zero));
+		memset(max_zero_idx, 0, sizeof(max_zero_idx));
+
+		op5k->op5k_backup[RF_PATH_A] = rtw89_phy_read32_mask(rtwdev, 0xc0d8, 0x000001e0);
+		op5k->op5k_backup[RF_PATH_B] = rtw89_phy_read32_mask(rtwdev, 0xc1d8, 0x000001e0);
+
+		rtw89_phy_write32_mask(rtwdev, 0xc0d4, BIT(4), 0x1);
+		rtw89_phy_write32_mask(rtwdev, 0xc1d4, BIT(4), 0x1);
+		rtw89_phy_write32_mask(rtwdev, 0x12b8, BIT(30), 0x1);
+		rtw89_phy_write32_mask(rtwdev, 0x32b8, BIT(30), 0x1);
+		rtw8192xb_op5k_reset_cnt(rtwdev);
+
+		for (i = 0; i < RTW89_OP5K_RESET_CNT_DATA; i++) {
+			for (j = 0; j < RF_PATH_NUM_8192XB; j++) {
+				rtw89_phy_write32_mask(rtwdev, 0xc0d8 | (j << 8),
+						       0x000001e0, i);
+				op5k->rst_cnt[j][i] =
+					rtw89_phy_read32_mask(rtwdev, 0xc0fc | (j << 8),
+							      0x0ff00000);
+				rtw8192xb_op5k_reset_cnt(rtwdev);
+			}
+		}
+
+		for (j = 0; j < RF_PATH_NUM_8192XB; j++) {
+			for (i = 0, k = 0; i < RTW89_OP5K_RESET_CNT_DATA; i++) {
+				if (zero_rst_cnt[j][k] == 0 && op5k->rst_cnt[j][i] == 0) {
+					zero_rst_cnt[j][k]++;
+					zero_start[j][k] = i;
+					zero_end[j][k] = i;
+				} else if (i > 0 && op5k->rst_cnt[j][i - 1] == 0 &&
+					   op5k->rst_cnt[j][i] == 0) {
+					zero_rst_cnt[j][k]++;
+					zero_end[j][k] = i;
+				} else if (zero_rst_cnt[j][k] != 0 && op5k->rst_cnt[j][i] == 0) {
+					k++;
+					zero_rst_cnt[j][k]++;
+					zero_start[j][k] = i;
+					zero_end[j][k] = i;
+				}
+			}
+		}
+
+		for (j = 0; j < RF_PATH_NUM_8192XB; j++) {
+			s32 upper, lower, final_val;
+
+			for (k = 0; k < RTW89_OP5K_RESET_CNT_DATA; k++) {
+				if (zero_rst_cnt[j][k] > max_zero[j]) {
+					max_zero[j] = zero_rst_cnt[j][k];
+					max_zero_idx[j] = k;
+				}
+			}
+
+			op5k->rst_cnt_zero[j][0] = zero_start[j][max_zero_idx[j]];
+			op5k->rst_cnt_zero[j][1] = zero_end[j][max_zero_idx[j]];
+
+			upper = (s32)op5k->op5k_backup[j] + RTW8192XB_OP5K_DIFF;
+			lower = (s32)op5k->op5k_backup[j] - RTW8192XB_OP5K_DIFF;
+			final_val = (op5k->rst_cnt_zero[j][0] + op5k->rst_cnt_zero[j][1]) / 2;
+			op5k->rst_cnt_final[j] = final_val;
+
+			if (final_val <= upper && final_val >= lower &&
+			    zero_rst_cnt[j][max_zero_idx[j]] >= 3) {
+				rtw89_phy_write32_mask(rtwdev, 0xc0d8 | (j << 8),
+						       0x000001e0, final_val & 0xf);
+				retry[j] = 2;
+			} else {
+				rtw89_phy_write32_mask(rtwdev, 0xc0d8 | (j << 8),
+						       0x000001e0,
+						       op5k->op5k_backup[j] & 0xf);
+				op5k->rst_cnt_final[j] = op5k->op5k_backup[j];
+				retry[j]++;
+			}
+
+			op5k->thermal_op5k[j] = rtw89_chip_get_thermal(rtwdev, j);
+		}
+
+		rtw89_phy_write32_mask(rtwdev, 0xc0d4, BIT(4), 0x0);
+		rtw89_phy_write32_mask(rtwdev, 0xc1d4, BIT(4), 0x0);
+		rtw89_phy_write32_mask(rtwdev, 0x12b8, BIT(30), 0x0);
+		rtw89_phy_write32_mask(rtwdev, 0x32b8, BIT(30), 0x0);
+	}
+
+	op5k->op5k_progress = false;
+}
+
+void rtw8192xb_op5k_track(struct rtw89_dev *rtwdev)
+{
+	struct rtw89_op5k_info *op5k = &rtwdev->op5k;
+	u8 thermal_val[RF_PATH_NUM_8192XB];
+	u32 thermal_avg[RF_PATH_NUM_8192XB] = {0};
+	s8 delta_op5k[RF_PATH_NUM_8192XB];
+	s8 delta_base[RF_PATH_NUM_8192XB];
+	u8 avg_cnt = 0;
+	u8 i, path;
+
+	if (rtwdev->hal.cv == CHIP_CAV || !op5k->op5k_set_ch_chk || rtwdev->scanning)
+		return;
+
+	for (path = RF_PATH_A; path < RF_PATH_NUM_8192XB; path++)
+		thermal_val[path] = rtw89_chip_get_thermal(rtwdev, path);
+
+	op5k->thermal_op5k_avg[RF_PATH_A][op5k->thermal_op5k_avg_index] =
+		thermal_val[RF_PATH_A];
+	op5k->thermal_op5k_avg[RF_PATH_B][op5k->thermal_op5k_avg_index] =
+		thermal_val[RF_PATH_B];
+	op5k->thermal_op5k_avg_index++;
+	if (op5k->thermal_op5k_avg_index == RTW89_OP5K_AVG_THERMAL_NUM)
+		op5k->thermal_op5k_avg_index = 0;
+
+	for (i = 0; i < RTW89_OP5K_AVG_THERMAL_NUM; i++) {
+		if (op5k->thermal_op5k_avg[RF_PATH_A][i] ||
+		    op5k->thermal_op5k_avg[RF_PATH_B][i]) {
+			thermal_avg[RF_PATH_A] += op5k->thermal_op5k_avg[RF_PATH_A][i];
+			thermal_avg[RF_PATH_B] += op5k->thermal_op5k_avg[RF_PATH_B][i];
+			avg_cnt++;
+		}
+	}
+
+	if (avg_cnt) {
+		thermal_val[RF_PATH_A] = thermal_avg[RF_PATH_A] / avg_cnt;
+		thermal_val[RF_PATH_B] = thermal_avg[RF_PATH_B] / avg_cnt;
+	}
+
+	for (path = RF_PATH_A; path < RF_PATH_NUM_8192XB; path++) {
+		delta_op5k[path] = thermal_val[path] - op5k->thermal_op5k[path];
+		delta_base[path] = thermal_val[path] - op5k->thermal_base_op5k[path];
+	}
+
+	if (delta_base[RF_PATH_A] < 0 || delta_base[RF_PATH_B] < 0) {
+		if (delta_op5k[RF_PATH_A] >= RTW8192XB_OP5K_THER_TH ||
+		    delta_op5k[RF_PATH_A] <= -RTW8192XB_OP5K_THER_TH ||
+		    delta_op5k[RF_PATH_B] >= RTW8192XB_OP5K_THER_TH ||
+		    delta_op5k[RF_PATH_B] <= -RTW8192XB_OP5K_THER_TH) {
+			rtw8192xb_op5k_trigger(rtwdev);
+			op5k->op5k_ther_chk = true;
+		}
+	} else if (op5k->op5k_ther_chk) {
+		rtw89_phy_write32_mask(rtwdev, 0xc0d8, 0x000001e0,
+				       op5k->op5k_default[RF_PATH_A] & 0xf);
+		rtw89_phy_write32_mask(rtwdev, 0xc1d8, 0x000001e0,
+				       op5k->op5k_default[RF_PATH_B] & 0xf);
+		op5k->op5k_ther_chk = false;
+	}
+}
