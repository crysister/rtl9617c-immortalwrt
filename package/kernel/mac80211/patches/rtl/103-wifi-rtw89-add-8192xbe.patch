+static const u32 rtw8192xb_sco_barker_threshold[14] = {
+	0x1fe4f, 0x1ff5e, 0x2006c, 0x2017b, 0x2028a, 0x20399, 0x204a8,
+	0x205b6, 0x206c5, 0x207d4, 0x208e3, 0x209f2, 0x20b00, 0x20d8a
+};
+
+static const u32 rtw8192xb_sco_cck_threshold[14] = {
+	0x2bdac, 0x2bf21, 0x2c095, 0x2c209, 0x2c37e, 0x2c4f2, 0x2c666,
+	0x2c7db, 0x2c94f, 0x2cac3, 0x2cc38, 0x2cdac, 0x2cf21, 0x2d29e
+};
+
+static int rtw8192xb_ctrl_sco_cck(struct rtw89_dev *rtwdev, u8 pri_ch)
+{
+	if (pri_ch > 14)
+		return -EINVAL;
+
+	rtw89_phy_write32_mask(rtwdev, 0x4a1c, 0x7ffff,
+			       rtw8192xb_sco_barker_threshold[pri_ch - 1]);
+	rtw89_phy_write32_mask(rtwdev, 0x4a20, 0x7ffff,
+			       rtw8192xb_sco_cck_threshold[pri_ch - 1]);
+
+	return 0;
+}
