+
+static const struct rtw8192xb_adc_ck adc_ck_960m = {{0x8, 0x2, 0x2, 0x4, 0xf, 0xa}};
+static const struct rtw8192xb_adc_ck adc_ck_1920m = {{0x9, 0x0, 0x0, 0x3, 0xf, 0xa}};
+
+static void rtw8192xb_rxck_force(struct rtw89_dev *rtwdev,
+				 enum rtw89_rf_path path, bool force, u8 ck)
+{
+	const struct rtw8192xb_adc_ck *data;
+	u32 p13 = path << 13;
+	u32 p8 = path << 8;
+
+	rtw89_phy_write32_mask(rtwdev, 0x12a0 | p13, BIT(19), 0);
+	if (!force)
+		return;
+
+	rtw89_phy_write32_mask(rtwdev, 0x12a0 | p13, 0x70000, ck);
+	rtw89_phy_write32_mask(rtwdev, 0x12a0 | p13, BIT(19), 1);
+
+	data = ck == RTW8192XB_ADC_960M ? &adc_ck_960m : &adc_ck_1920m;
+
+	rtw89_phy_write32_mask(rtwdev, 0xc0d4 | p8, 0x780, data->val[0]);
+	rtw89_phy_write32_mask(rtwdev, 0xc0d4 | p8, 0x7800, data->val[1]);
+	rtw89_phy_write32_mask(rtwdev, 0xc0d4 | p8, 0x0c000000, data->val[2]);
+	rtw89_phy_write32_mask(rtwdev, 0xc0d8 | p8, 0x1e0, data->val[3]);
+	rtw89_phy_write32_mask(rtwdev, 0xc0c4 | p8, 0x3e0000, data->val[4]);
+	rtw89_phy_write32_mask(rtwdev, 0xc0e8 | p8, 0xffff0000, data->val[5]);
+}
+
+static bool rtw8192xb_rfk_wait(struct rtw89_dev *rtwdev, u32 addr, u32 mask)
+{
+	u32 val;
+
+	return read_poll_timeout(rtw89_phy_read32_mask, val, val, 1,
+				 RTW8192XB_RFK_POLL_US, false,
+				 rtwdev, addr, mask) == 0;
+}
+
+void rtw8192xb_rfk_rck(struct rtw89_dev *rtwdev)
+{
+	u32 val, rck_code;
+	int path, i;
+
+	for (path = RF_PATH_A; path <= RF_PATH_B; path++) {
+		rtw89_write_rf(rtwdev, path, RR_RSV1, RFREG_MASK, 0);
+		rtw89_write_rf(rtwdev, path, RR_MOD, RR_MOD_MASK, RR_MOD_V_RX);
+		rtw89_write_rf(rtwdev, path, 0x1b, RFREG_MASK, 0x240);
+
+		for (i = 0; i <= 10; i++) {
+			val = rtw89_read_rf(rtwdev, path, 0x1c, RFREG_MASK);
+			if (val & BIT(3))
+				break;
+			udelay(2);
+		}
+
+		rck_code = rtw89_read_rf(rtwdev, path, 0x1b, GENMASK(14, 10));
+		rtw89_write_rf(rtwdev, path, 0x1b, RFREG_MASK, rck_code);
+		rtw89_write_rf(rtwdev, path, RR_RSV1, RFREG_MASK, 1);
+	}
+}
+
+static void rtw8192xb_dack_drck(struct rtw89_dev *rtwdev)
+{
+	u32 rck_d;
+
+	rtw89_phy_write32_mask(rtwdev, 0xc0c4, BIT(9), 1);
+	rtw89_phy_write32_mask(rtwdev, 0xc0c4, BIT(6), 1);
+
+	if (!rtw8192xb_rfk_wait(rtwdev, 0xc0c8, BIT(3)))
+		rtw89_debug(rtwdev, RTW89_DBG_RFK, "[DACK] DRCK timeout\n");
+
+	rtw89_phy_write32_mask(rtwdev, 0xc0c4, BIT(6), 0);
+	rtw89_phy_write32_mask(rtwdev, 0xc094, BIT(9), 1);
+	udelay(1);
+	rtw89_phy_write32_mask(rtwdev, 0xc094, BIT(9), 0);
+
+	rck_d = rtw89_phy_read32_mask(rtwdev, 0xc0c8, 0x7c00);
+	rtw89_phy_write32_mask(rtwdev, 0xc0c4, BIT(9), 0);
+	rtw89_phy_write32_mask(rtwdev, 0xc0c4, 0x1f, rck_d);
+}
+
+static void rtw8192xb_dack_manual_off(struct rtw89_dev *rtwdev)
+{
+	rtw89_phy_write32_mask(rtwdev, 0xc0f8, 0x30000000, 0);
+	rtw89_phy_write32_mask(rtwdev, 0xc1f8, 0x30000000, 0);
+	rtw89_phy_write32_mask(rtwdev, 0xc210, BIT(0), 0);
+	rtw89_phy_write32_mask(rtwdev, 0xc224, BIT(0), 0);
+	rtw89_phy_write32_mask(rtwdev, 0xc238, BIT(0), 0);
+	rtw89_phy_write32_mask(rtwdev, 0xc24c, BIT(0), 0);
+}
+
+static void rtw8192xb_addck_path(struct rtw89_dev *rtwdev,
+				 enum rtw89_rf_path path)
+{
+	struct rtw89_dack_info *dack = &rtwdev->dack;
+	u32 p13 = path << 13;
+	u32 p8 = path << 8;
+
+	rtw89_phy_write32_mask(rtwdev, 0x12b8 | p13, BIT(30), 1);
+	rtw89_phy_write32_mask(rtwdev, 0x032c, BIT(30), 0);
+	rtw89_phy_write32_mask(rtwdev, 0x032c, BIT(22), 0);
+	rtw89_phy_write32_mask(rtwdev, 0x032c, BIT(22), 1);
+
+	rtw89_phy_write32_mask(rtwdev, 0x030c, 0x0f000000, 0xf);
+	udelay(100);
+	rtw89_phy_write32_mask(rtwdev, 0x032c, BIT(16), 0);
+	rtw89_phy_write32_mask(rtwdev, 0xc0d4 | p8, BIT(4), 1);
+	rtw89_phy_write32_mask(rtwdev, 0x030c, 0x0f000000, 0x3);
+
+	rtw89_phy_write32_mask(rtwdev, 0xc0f4 | p8, BIT(11), 1);
+	rtw89_phy_write32_mask(rtwdev, 0xc0f4 | p8, BIT(11), 0);
+	udelay(1);
+	rtw89_phy_write32_mask(rtwdev, 0xc0f4 | p8, 0x300, 0x1);
+
+	dack->addck_timeout[path] = !rtw8192xb_rfk_wait(rtwdev, 0xc0fc | p8, BIT(0));
+
+	rtw89_phy_write32_mask(rtwdev, 0xc0d4 | p8, BIT(4), 0);
+	rtw89_phy_write32_mask(rtwdev, 0x032c, BIT(16), 1);
+	rtw89_phy_write32_mask(rtwdev, 0x030c, 0x0f000000, 0xc);
+	rtw89_phy_write32_mask(rtwdev, 0x032c, BIT(30), 1);
+
+	rtw89_phy_write32_mask(rtwdev, 0xc0f4 | p8, 0x300, 0);
+	dack->addck_d[path][0] = rtw89_phy_read32_mask(rtwdev, 0xc0fc | p8, 0xffc00);
+	dack->addck_d[path][1] = rtw89_phy_read32_mask(rtwdev, 0xc0fc | p8, 0x003ff);
+	rtw89_phy_write32_mask(rtwdev, 0x12b8 | p13, BIT(30), 0);
+}
+
+static bool rtw8192xb_addck_unsettled(struct rtw89_dack_info *dack)
+{
+	int path, i;
+
+	for (path = 0; path < RTW89_DACK_PATH_NR; path++)
+		for (i = 0; i < RTW89_DACK_IDX_NR; i++)
+			if (dack->addck_d[path][i] > 0x100 &&
+			    dack->addck_d[path][i] < 0x300)
+				return true;
+
+	return false;
+}
+
+static void rtw8192xb_addck(struct rtw89_dev *rtwdev)
+{
+	struct rtw89_dack_info *dack = &rtwdev->dack;
+	int i;
+
+	for (i = 0; i <= 10; i++) {
+		rtw89_phy_write32_mask(rtwdev, 0xc0f4, 0x30, 0);
+		rtw89_phy_write32_mask(rtwdev, 0xc1f4, 0x30, 0);
+		rtw8192xb_addck_path(rtwdev, RF_PATH_A);
+		rtw8192xb_addck_path(rtwdev, RF_PATH_B);
+
+		if (!rtw8192xb_addck_unsettled(dack))
+			break;
+	}
+}
+
+static void rtw8192xb_addck_reload(struct rtw89_dev *rtwdev)
+{
+	struct rtw89_dack_info *dack = &rtwdev->dack;
+	int path;
+
+	for (path = RF_PATH_A; path <= RF_PATH_B; path++) {
+		u32 p8 = path << 8;
+
+		rtw89_phy_write32_mask(rtwdev, 0xc0f8 | p8, 0x0ffc0000,
+				       dack->addck_d[path][0]);
+		rtw89_phy_write32_mask(rtwdev, 0xc0f8 | p8, 0x0003ff00,
+				       dack->addck_d[path][1]);
+		rtw89_phy_write32_mask(rtwdev, 0xc0f8 | p8, 0x30000000, 0x3);
+	}
+}
+
+static void rtw8192xb_dack_reload_idx(struct rtw89_dev *rtwdev,
+				      enum rtw89_rf_path path, u8 idx)
+{
+	struct rtw89_dack_info *dack = &rtwdev->dack;
+	u32 ofst = (idx ? 0x14 : 0) + (path == RF_PATH_A ? 0 : 0x28);
+	u32 val;
+	int i, j;
+
+	rtw89_phy_write32_mask(rtwdev, 0xc004, BIT(17), 1);
+	rtw89_phy_write32_mask(rtwdev, 0xc024, BIT(17), 1);
+	rtw89_phy_write32_mask(rtwdev, 0xc104, BIT(17), 1);
+	rtw89_phy_write32_mask(rtwdev, 0xc124, BIT(17), 1);
+
+	for (i = 0; i < 4; i++) {
+		for (val = 0, j = 0; j < 4; j++)
+			val |= dack->msbk_d[path][idx][(3 - i) * 4 + j] << (j * 8);
+		rtw89_phy_write32(rtwdev, 0xc200 + i * 4 + ofst, val);
+	}
+
+	val = dack->biask_d[path][idx] << 22 | dack->dadck_d[path][idx] << 14;
+	rtw89_phy_write32(rtwdev, 0xc210 + ofst, val);
+	rtw89_phy_write32_mask(rtwdev, 0xc210 + ofst, BIT(0), 1);
+}
+
+static void rtw8192xb_dack_backup(struct rtw89_dev *rtwdev,
+				  enum rtw89_rf_path path)
+{
+	struct rtw89_dack_info *dack = &rtwdev->dack;
+	u32 p8 = path << 8;
+	int i;
+
+	rtw89_phy_write32_mask(rtwdev, 0x12b8 | (path << 13), BIT(30), 1);
+
+	for (i = 0; i < RTW89_DACK_MSBK_NR; i++) {
+		rtw89_phy_write32_mask(rtwdev, 0xc000 | p8, 0x1e, i);
+		dack->msbk_d[path][0][i] =
+			rtw89_phy_read32_mask(rtwdev, 0xc05c | p8, 0xff000000);
+		rtw89_phy_write32_mask(rtwdev, 0xc020 | p8, 0x1e, i);
+		dack->msbk_d[path][1][i] =
+			rtw89_phy_read32_mask(rtwdev, 0xc080 | p8, 0xff000000);
+	}
+
+	dack->biask_d[path][0] = rtw89_phy_read32_mask(rtwdev, 0xc048 | p8, 0xffc);
+	dack->biask_d[path][1] = rtw89_phy_read32_mask(rtwdev, 0xc06c | p8, 0xffc);
+	dack->dadck_d[path][0] = rtw89_phy_read32_mask(rtwdev, 0xc060 | p8, 0xff000000);
+	dack->dadck_d[path][1] = rtw89_phy_read32_mask(rtwdev, 0xc084 | p8, 0xff000000);
+}
+
+static void rtw8192xb_dack_path(struct rtw89_dev *rtwdev,
+				enum rtw89_rf_path path)
+{
+	struct rtw89_dack_info *dack = &rtwdev->dack;
+	u32 p13 = path << 13;
+	u32 p8 = path << 8;
+	bool ok;
+
+	rtw89_phy_write32_mask(rtwdev, 0x12a0 | p13, BIT(15), 1);
+	rtw89_phy_write32_mask(rtwdev, 0x12a0 | p13, 0x7000, 0x3);
+	rtw89_phy_write32_mask(rtwdev, 0x12b8 | p13, BIT(30), 1);
+	rtw89_phy_write32_mask(rtwdev, 0x030c, BIT(28), 1);
+	rtw89_phy_write32_mask(rtwdev, 0x032c, 0x80000000, 0);
+	udelay(100);
+
+	rtw89_phy_write32_mask(rtwdev, 0xc000 | p8, BIT(17), 0);
+	rtw89_phy_write32_mask(rtwdev, 0xc000 | p8, BIT(17), 1);
+
+	rtw89_phy_write32_mask(rtwdev, 0xc004 | p8, BIT(0), 1);
+
+	ok = rtw8192xb_rfk_wait(rtwdev, 0xc040 | p8, BIT(31)) &&
+	     rtw8192xb_rfk_wait(rtwdev, 0xc064 | p8, BIT(31)) &&
+	     rtw8192xb_rfk_wait(rtwdev, 0xc05c | p8, BIT(2)) &&
+	     rtw8192xb_rfk_wait(rtwdev, 0xc080 | p8, BIT(2));
+	dack->msbk_timeout[path] = !ok;
+
+	rtw89_phy_write32_mask(rtwdev, 0xc004 | p8, BIT(0), 0);
+	rtw89_phy_write32_mask(rtwdev, 0x12a0 | p13, BIT(15), 0);
+	rtw89_phy_write32_mask(rtwdev, 0x12a0 | p13, 0x7000, 0x7);
+
+	rtw8192xb_dack_backup(rtwdev, path);
+	rtw8192xb_dack_reload_idx(rtwdev, path, 0);
+	rtw8192xb_dack_reload_idx(rtwdev, path, 1);
+
+	rtw89_phy_write32_mask(rtwdev, 0x12b8 | p13, BIT(30), 0);
+}
+
+void rtw8192xb_rfk_dack(struct rtw89_dev *rtwdev)
+{
+	struct rtw89_dack_info *dack = &rtwdev->dack;
+	u32 rf_mod[2];
+	int path;
+
+	dack->dack_done = false;
+
+	for (path = RF_PATH_A; path <= RF_PATH_B; path++)
+		rf_mod[path] = rtw89_read_rf(rtwdev, path, RR_MOD, RFREG_MASK);
+
+	rtw8192xb_dack_drck(rtwdev);
+	rtw8192xb_dack_manual_off(rtwdev);
+
+	for (path = RF_PATH_A; path <= RF_PATH_B; path++) {
+		rtw89_write_rf(rtwdev, path, RR_RSV1, RFREG_MASK, 0);
+		rtw89_write_rf(rtwdev, path, RR_MOD, RFREG_MASK, 0x337e1);
+		rtw8192xb_rxck_force(rtwdev, path, true, RTW8192XB_ADC_960M);
+	}
+
+	rtw8192xb_addck(rtwdev);
+
+	for (path = RF_PATH_A; path <= RF_PATH_B; path++)
+		rtw8192xb_rxck_force(rtwdev, path, false, RTW8192XB_ADC_960M);
+
+	rtw8192xb_addck_reload(rtwdev);
+
+	for (path = RF_PATH_A; path <= RF_PATH_B; path++)
+		rtw89_write_rf(rtwdev, path, 0x1, RFREG_MASK, 0);
+
+	rtw8192xb_dack_path(rtwdev, RF_PATH_A);
+	rtw8192xb_dack_path(rtwdev, RF_PATH_B);
+
+	dack->dack_done = true;
+	dack->dack_cnt++;
+
+	for (path = RF_PATH_A; path <= RF_PATH_B; path++) {
+		rtw89_write_rf(rtwdev, path, RR_MOD, RFREG_MASK, rf_mod[path]);
+		rtw89_write_rf(rtwdev, path, RR_RSV1, RR_RSV1_RST, 1);
+	}
+}
+
+static void rtw8192xb_rx_dck_path(struct rtw89_dev *rtwdev,
+				  enum rtw89_rf_path path)
+{
+	u32 p13 = path << 13;
+	u32 p8 = path << 8;
+	u32 reg_12a0, reg_c0d4, reg_c0d8, reg_c0c4, reg_c0e8, reg_8034, reg_80d4;
+	int i;
+
+	rtw89_write_rf(rtwdev, path, 0x93, 0x0000f, 0x8);
+
+	reg_12a0 = rtw89_phy_read32(rtwdev, 0x12a0 + p13);
+	reg_c0d4 = rtw89_phy_read32(rtwdev, 0xc0d4 + p8);
+	reg_c0d8 = rtw89_phy_read32(rtwdev, 0xc0d8 + p8);
+	reg_c0c4 = rtw89_phy_read32(rtwdev, 0xc0c4 + p8);
+	reg_c0e8 = rtw89_phy_read32(rtwdev, 0xc0e8 + p8);
+	reg_8034 = rtw89_phy_read32(rtwdev, 0x8034);
+	reg_80d4 = rtw89_phy_read32(rtwdev, 0x80d4);
+
+	rtw89_phy_write32_mask(rtwdev, 0x12b8 + p13, BIT(30), 1);
+	rtw8192xb_rxck_force(rtwdev, path, true, RTW8192XB_ADC_1920M);
+
+	rtw89_phy_write32_mask(rtwdev, 0xc0f8 + p8, GENMASK(29, 28), 0x3);
+	rtw89_phy_write32_mask(rtwdev, 0xc0f4 + p8, GENMASK(7, 6), 0x3);
+	rtw89_phy_write32_mask(rtwdev, 0x032c, GENMASK(18, 16), 0x1);
+	rtw89_phy_write32_mask(rtwdev, 0x030c, 0x0f000000, 0xf);
+	rtw89_phy_write32_mask(rtwdev, 0x030c, 0x0f000000, 0x3);
+	rtw89_phy_write32_mask(rtwdev, 0x032c, BIT(30), 0);
+	rtw89_phy_write32_mask(rtwdev, 0x032c, BIT(22), 0);
+	rtw89_phy_write32_mask(rtwdev, 0x032c, BIT(22), 1);
+
+	rtw89_phy_write32_mask(rtwdev, 0x5670, BIT(1), 1);
+
+	rtw89_phy_write32_mask(rtwdev, 0x8008, BIT(7), 1);
+	rtw89_phy_write32_mask(rtwdev, 0x8034, GENMASK(5, 4), 0x2);
+	rtw89_phy_write32_mask(rtwdev, 0x80d4, GENMASK(10, 8), 0x1);
+	rtw89_phy_write32_mask(rtwdev, 0x81e0, GENMASK(22, 20), 0x0);
+	rtw89_phy_write32_mask(rtwdev, 0x81e0, BIT(25), 0);
+	rtw89_phy_write32_mask(rtwdev, 0x82e0, GENMASK(22, 20), 0x1);
+	rtw89_phy_write32_mask(rtwdev, 0x82e0, BIT(25), 0);
+	rtw89_phy_write32_mask(rtwdev, 0x8000, GENMASK(2, 1), path);
+
+	rtw89_phy_write32(rtwdev, 0x80ac, 0xfc030001);
+	rtw89_phy_write32(rtwdev, 0x80ac, 0x7c030001);
+	rtw89_phy_write32_mask(rtwdev, 0x80d4, 0x003f0000, 0x34);
+
+	for (i = 0; i < 1500; i++) {
+		if (rtw89_phy_read32_mask(rtwdev, 0x80fc, BIT(16)))
+			break;
+		udelay(2);
+	}
+
+	rtw89_phy_write32(rtwdev, 0x80ac, 0xfc050001);
+	rtw89_phy_write32(rtwdev, 0x80ac, 0x7c050001);
+	rtw89_phy_write32_mask(rtwdev, 0x80d4, 0x003f0000, 0x34);
+
+	for (i = 0; i < 1500; i++) {
+		if (rtw89_phy_read32_mask(rtwdev, 0x80fc, BIT(16)))
+			break;
+		udelay(2);
+	}
+
+	rtw89_phy_write32(rtwdev, 0x8008, 0);
+	rtw89_phy_write32_mask(rtwdev, 0x12b8 + p13, BIT(30), 0);
+	rtw89_phy_write32(rtwdev, 0x12a0 + p13, reg_12a0);
+	rtw89_phy_write32(rtwdev, 0xc0d4 + p8, reg_c0d4);
+	rtw89_phy_write32(rtwdev, 0xc0d8 + p8, reg_c0d8);
+	rtw89_phy_write32(rtwdev, 0xc0c4 + p8, reg_c0c4);
+	rtw89_phy_write32(rtwdev, 0xc0e8 + p8, reg_c0e8);
+	rtw89_phy_write32(rtwdev, 0x8034, reg_8034);
+	rtw89_phy_write32(rtwdev, 0x80d4, reg_80d4);
+	rtw89_phy_write32_mask(rtwdev, 0x5670, BIT(1), 0);
+}
+
+void rtw8192xb_rfk_rx_dck(struct rtw89_dev *rtwdev)
+{
+	int path;
+
+	rtw89_phy_write32(rtwdev, 0x8080, 0x4);
+
+	for (path = RF_PATH_A; path <= RF_PATH_B; path++) {
+		if (rtwdev->is_tssi_mode[path])
+			rtw89_phy_write32_mask(rtwdev, 0x5818 + (path << 13),
+					       BIT(30), 0x1);
+		rtw89_write_rf(rtwdev, path, RR_RSV1, RFREG_MASK, 0);
+		rtw89_write_rf(rtwdev, path, RR_MOD, RR_MOD_MASK, RR_MOD_V_RX);
+		rtw89_write_rf(rtwdev, path, 0x93, 0xf, 0x8);
+		rtw8192xb_rx_dck_path(rtwdev, path);
+		rtw89_write_rf(rtwdev, path, RR_RSV1, RFREG_MASK, 1);
+		if (rtwdev->is_tssi_mode[path])
+			rtw89_phy_write32_mask(rtwdev, 0x5818 + (path << 13),
+					       BIT(30), 0x0);
+	}
+
+	rtw89_phy_write32(rtwdev, 0x8080, 0);
+
+	for (path = RF_PATH_A; path <= RF_PATH_B; path++) {
+		rtw89_write_rf(rtwdev, path, RR_MOD, RR_MOD_MASK, RR_MOD_V_RX);
+		rtw89_write_rf(rtwdev, path, RR_RSV1, RFREG_MASK, 1);
+	}
+}
+
+static bool rtw8192xb_iqk_shot(struct rtw89_dev *rtwdev,
+			       enum rtw89_rf_path path, u32 cmd, bool rf_ctrl)
+{
+	u32 p13 = path << 13;
+	u32 val;
+	bool fail = false;
+	int i;
+
+	if (rf_ctrl)
+		rtw89_phy_write32_mask(rtwdev, 0x5670 + p13, BIT(1), 1);
+
+	rtw89_phy_write32(rtwdev, 0x8000, (cmd | BIT(4 + path)) + 1);
+	udelay(1);
+
+	for (i = 0; i <= 8200; i++) {
+		val = rtw89_phy_read32_mask(rtwdev, 0xbff8, 0xff);
+		if (val == 0x55) {
+			udelay(1);
+			break;
+		}
+		udelay(1);
+		if (i == 8200)
+			fail = true;
+	}
+
+	if (fail) {
+		val = rtw89_phy_read32_mask(rtwdev, 0x80fc, 0xffff);
+		udelay(1);
+		if (val == 0x8000)
+			fail = false;
+	}
+
+	udelay(10);
+	if (!fail)
+		fail = !!rtw89_phy_read32_mask(rtwdev, 0x8008, BIT(26));
+
+	rtw89_phy_write32_mask(rtwdev, 0x8010, 0xff, 0);
+	rtw89_phy_write32_mask(rtwdev, 0x5670 + p13, BIT(1), 0);
+
+	return fail;
+}
+
+static void rtw8192xb_iqk_prepare(struct rtw89_dev *rtwdev,
+				  enum rtw89_rf_path path)
+{
+	u32 p13 = path << 13;
+	u32 p8 = path << 8;
+
+	rtw89_write_rf(rtwdev, path, 0x10005, BIT(0), 0);
+	rtw89_phy_write32_mask(rtwdev, 0x20fc, BIT(16 + path), 1);
+	rtw89_phy_write32_mask(rtwdev, 0x20fc, BIT(20 + path), 0);
+	rtw89_phy_write32_mask(rtwdev, 0x20fc, BIT(24 + path), 1);
+	rtw89_phy_write32_mask(rtwdev, 0x20fc, BIT(28 + path), 0);
+	rtw89_phy_write32_mask(rtwdev, path ? 0x4a9c : 0x4730, BIT(31), 0);
+	rtw89_phy_write32(rtwdev, 0x5670 + p13, 0xf801fffd);
+	rtw89_phy_write32_mask(rtwdev, 0x5670 + p13, BIT(14), 1);
+	rtw89_phy_write32_mask(rtwdev, 0x5670 + p13, BIT(31), 1);
+	rtw89_phy_write32_mask(rtwdev, 0x12a0 + p13, BIT(15), 0);
+	rtw89_phy_write32_mask(rtwdev, 0x12a0 + p13, 0x7000, 7);
+	rtw89_phy_write32_mask(rtwdev, 0x12a0 + p13, BIT(15), 1);
+	rtw89_phy_write32_mask(rtwdev, 0x5670 + p13, BIT(13), 1);
+	rtw8192xb_rxck_force(rtwdev, path, true, RTW8192XB_ADC_1920M);
+	rtw89_phy_write32_mask(rtwdev, 0x5670 + p13, 0x60000000, 2);
+	rtw89_phy_write32_mask(rtwdev, 0xc0ec + p8, 0x6000, 0);
+	rtw89_phy_write32_mask(rtwdev, 0x12b8 + p13, BIT(30), 1);
+	rtw89_phy_write32_mask(rtwdev, 0x030c, 0xff000000, 0x1f);
+	rtw89_phy_write32_mask(rtwdev, 0x030c, 0xff000000, 0x13);
+	rtw89_phy_write32_mask(rtwdev, 0x032c, 0xffff0000, 0x0001);
+	rtw89_phy_write32_mask(rtwdev, 0x032c, 0xffff0000, 0x0041);
+	rtw89_phy_write32_mask(rtwdev, 0x20fc, BIT(20 + path), 1);
+	rtw89_phy_write32_mask(rtwdev, 0x20fc, BIT(28 + path), 1);
+	rtw89_write_rf(rtwdev, path, RR_RSV1, RFREG_MASK, 0);
+	rtw89_phy_write32(rtwdev, 0x8008, 0x80);
+	rtw89_phy_write32(rtwdev, 0x8088, 0x81ff010a);
+}
+
+static void rtw8192xb_iqk_lok(struct rtw89_dev *rtwdev,
+			      enum rtw89_rf_path path)
+{
+	static const u32 cmds[4] = {0x108, 0x308, 0x208, 0x308};
+	int i;
+
+	rtw89_write_rf(rtwdev, path, 0x51, BIT(19), 0);
+	rtw89_write_rf(rtwdev, path, 0x51, BIT(11), 0);
+	rtw89_write_rf(rtwdev, path, 0x52, BIT(11), 1);
+	rtw89_write_rf(rtwdev, path, 0x55, 0x1f, 0);
+	rtw89_write_rf(rtwdev, path, 0xef, BIT(2), 1);
+	rtw89_write_rf(rtwdev, path, 0x33, 0xff, 0);
+	rtw89_write_rf(rtwdev, path, RR_MOD, RFREG_MASK, 0x403e1);
+	udelay(10);
+
+	rtw89_write_rf(rtwdev, path, 0x11, 0x3, 0);
+	rtw89_write_rf(rtwdev, path, 0x11, 0x70, 6);
+	rtw89_write_rf(rtwdev, path, 0x11, 0x1f000, 6);
+	rtw89_phy_write32_mask(rtwdev, 0x802c, 0xfff, 0x21);
+
+	for (i = 0; i < 4; i++) {
+		rtw89_write_rf(rtwdev, path, 0x11, 0x1f000, i & 1 ? 18 : 6);
+		rtw89_phy_write32(rtwdev, 0x81cc + (path << 8), i & 1 ? 27 : 9);
+		rtw8192xb_iqk_shot(rtwdev, path, cmds[i], true);
+	}
+}
+
+static bool rtw8192xb_iqk_txk(struct rtw89_dev *rtwdev,
+			      enum rtw89_rf_path path, u8 bw)
+{
+	static const u32 track[4] = {4, 4, 6, 6};
+	static const u32 gain[4] = {20, 20, 8, 14};
+	u32 p8 = path << 8;
+	bool fail = false;
+	int g;
+
+	for (g = 1; g < 4; g++) {
+		rtw89_write_rf(rtwdev, path, 0x11, 0x3, 0);
+		rtw89_write_rf(rtwdev, path, 0x11, 0x70, track[g]);
+		rtw89_write_rf(rtwdev, path, 0x11, 0x1f000, gain[g]);
+		rtw89_phy_write32_mask(rtwdev, 0x81cc + p8, 0x3f, 18);
+		rtw89_phy_write32_mask(rtwdev, 0x8154 + p8, BIT(8), 1);
+		rtw89_phy_write32_mask(rtwdev, 0x8154 + p8, BIT(3), 1);
+		rtw89_phy_write32_mask(rtwdev, 0x8154 + p8, BIT(2), 0);
+		rtw89_phy_write32_mask(rtwdev, 0x8154 + p8, 0x3, g);
+		rtw89_phy_write32_mask(rtwdev, 0x8010, 0xff, 0);
+		fail |= rtw8192xb_iqk_shot(rtwdev, path, 0x808 + (bw << 8), false);
+	}
+
+	return fail;
+}
+
+static bool rtw8192xb_iqk_rxk(struct rtw89_dev *rtwdev,
+			      enum rtw89_rf_path path, u8 bw)
+{
+	static const u32 gains[4] = {0x150, 0x158, 0x2d0, 0x2d8};
+	u32 p13 = path << 13;
+	u32 p8 = path << 8;
+	bool fail = false;
+	u32 val;
+	int g;
+
+	rtw89_phy_write32_mask(rtwdev, 0x20fc, 0xffff0000, path ? 0x202 : 0x101);
+	rtw89_phy_write32_mask(rtwdev, 0x5670 + p13, BIT(13), 1);
+	rtw8192xb_rxck_force(rtwdev, path, true, RTW8192XB_ADC_960M);
+	rtw89_phy_write32_mask(rtwdev, 0x5670 + p13, 0x60000000, 0);
+	rtw89_phy_write32_mask(rtwdev, 0xc0ec + p8, 0x6000, 2);
+	rtw89_write_rf(rtwdev, path, 0x8f, BIT(12), 1);
+	rtw89_phy_write32_mask(rtwdev, 0x12b8 + p13, BIT(30), 1);
+	rtw89_phy_write32_mask(rtwdev, 0x030c, 0xff000000, 0x0f);
+	rtw89_phy_write32_mask(rtwdev, 0x030c, 0xff000000, 0x03);
+	rtw89_phy_write32_mask(rtwdev, 0x032c, 0xffff0000, 0x0001);
+	rtw89_phy_write32_mask(rtwdev, 0x032c, 0xffff0000, 0x0041);
+	rtw89_phy_write32_mask(rtwdev, 0x20fc, 0xffff0000, path ? 0x2202 : 0x1101);
+
+	if (path == RF_PATH_B) {
+		rtw89_write_rf(rtwdev, RF_PATH_B, 0xdc, 0x300, 3);
+		val = rtw89_read_rf(rtwdev, RF_PATH_B, 0x17, RFREG_MASK);
+		rtw89_write_rf(rtwdev, RF_PATH_B, 0x1f, 0x30000, (val >> 10) & 3);
+		rtw89_write_rf(rtwdev, RF_PATH_B, 0x1f, 0x3ff, val & 0x3ff);
+	}
+
+	rtw89_write_rf(rtwdev, path, RR_MOD, RR_MOD_MASK, 12);
+	rtw89_write_rf(rtwdev, path, 0x84, 0xf0000, 10);
+	udelay(10);
+
+	for (g = 0; g < 4; g++) {
+		rtw89_write_rf(rtwdev, path, RR_MOD, 0x3ff0, gains[g]);
+		rtw89_write_rf(rtwdev, path, 0x83, 0xf000, 0);
+		rtw89_phy_write32_mask(rtwdev, 0x8154 + p8, BIT(8), 1);
+		rtw89_phy_write32_mask(rtwdev, 0x8154 + p8, BIT(3), 0);
+		rtw89_phy_write32_mask(rtwdev, 0x8154 + p8, 0x7, g);
+		rtw89_write_rf(rtwdev, path, 0x1e, RFREG_MASK, 0x80013);
+		udelay(200);
+		val = rtw89_read_rf(rtwdev, path, RR_MOD, RFREG_MASK);
+		rtw89_phy_write32_mask(rtwdev, 0x8024, RFREG_MASK, val);
+		rtw89_phy_write32_mask(rtwdev, 0x8044, 0xe000, g);
+		rtw89_phy_write32_mask(rtwdev, 0x802c, 0x0fff0000, 0x11);
+		rtw8192xb_iqk_shot(rtwdev, path, 0x708, true);
+		udelay(10);
+		fail |= rtw8192xb_iqk_shot(rtwdev, path, 0xc08 + (bw << 8), true);
+	}
+
+	if (path == RF_PATH_B)
+		rtw89_write_rf(rtwdev, RF_PATH_B, 0xdc, 0x300, 0);
+
+	return fail;
+}
+
+void rtw8192xb_rfk_iqk(struct rtw89_dev *rtwdev, enum rtw89_phy_idx phy_idx)
+{
+	static const u32 bb_regs[] = {
+		0x2344, 0xc0d4, 0xc0d8, 0xc0c4, 0xc0e8, 0xc0ec,
+		0xc1d4, 0xc1d8, 0xc1c4, 0xc1e8, 0xc1ec,
+	};
+	static const u32 rf_regs[] = {0xdc, 0xef, 0xde, 0, 0x1e, 5, 0x10005};
+	const struct rtw89_chan *chan = rtw89_chan_get(rtwdev, RTW89_CHANCTX_0);
+	u8 bw = chan->band_width == RTW89_CHANNEL_WIDTH_40 ? 1 : 0;
+	u32 bb_saved[ARRAY_SIZE(bb_regs)];
+	u32 rf_saved[ARRAY_SIZE(rf_regs)];
+	int path, i;
+
+	rtw89_phy_write32(rtwdev, 0x9fe0, 0);
+
+	for (path = RF_PATH_A; path <= RF_PATH_B; path++) {
+		u32 p13 = path << 13;
+		u32 p8 = path << 8;
+		bool tx_fail, rx_fail;
+
+		rtw89_phy_write32_mask(rtwdev, 0x9fe0, 0xff000000, 6);
+		rtw89_phy_write32_mask(rtwdev, 0x9fe4, 0xfU << (path * 16), 0);
+		rtw89_phy_write32_mask(rtwdev, 0x9fe4, 0xf0U << (path * 16), bw);
+		rtw89_phy_write32_mask(rtwdev, 0x9fe4, 0xff00U << (path * 16),
+				       chan->channel);
+		rtw89_phy_write32_mask(rtwdev, 0x9fe8, 0xff, 10);
+
+		for (i = 0; i < ARRAY_SIZE(bb_regs); i++)
+			bb_saved[i] = rtw89_phy_read32(rtwdev, bb_regs[i]);
+		for (i = 0; i < ARRAY_SIZE(rf_regs); i++)
+			rf_saved[i] = rtw89_read_rf(rtwdev, path, rf_regs[i],
+						    RFREG_MASK);
+
+		rtw8192xb_iqk_prepare(rtwdev, path);
+		rtw8192xb_iqk_lok(rtwdev, path);
+		tx_fail = rtw8192xb_iqk_txk(rtwdev, path, bw);
+		rx_fail = rtw8192xb_iqk_rxk(rtwdev, path, bw);
+
+		rtw89_phy_write32(rtwdev, 0x8138 + p8,
+				  tx_fail ? 0x40000002 : 0x40000000);
+		rtw89_phy_write32(rtwdev, 0x813c + p8,
+				  rx_fail ? 0x40000002 : 0x40000000);
+		rtw8192xb_iqk_shot(rtwdev, path, 0x1208, false);
+
+		rtw89_phy_write32_mask(rtwdev, 0x8010, 0xff, 0);
+		rtw89_phy_write32(rtwdev, 0x8008, 0);
+		rtw89_phy_write32(rtwdev, 0x8088, 0x80000000);
+		rtw89_write_rf(rtwdev, path, 0xef, BIT(2), 0);
+		rtw89_write_rf(rtwdev, path, RR_MOD, RR_MOD_MASK, RR_MOD_V_RX);
+		rtw89_write_rf(rtwdev, path, RR_RSV1, RFREG_MASK, 1);
+
+		rtw89_phy_write32_mask(rtwdev, 0x12b8 + p13, BIT(30), 0);
+		rtw89_phy_write32_mask(rtwdev, 0x20fc, BIT(16 + path), 1);
+		rtw89_phy_write32_mask(rtwdev, 0x20fc, BIT(20 + path), 0);
+		rtw89_phy_write32_mask(rtwdev, 0x20fc, BIT(24 + path), 1);
+		rtw89_phy_write32_mask(rtwdev, 0x20fc, BIT(28 + path), 0);
+		rtw89_phy_write32(rtwdev, 0x5670 + p13, 0);
+		rtw89_phy_write32_mask(rtwdev, 0x12a0 + p13, 0xff000, 0);
+		rtw89_phy_write32_mask(rtwdev, 0x20fc, BIT(16 + path), 0);
+		rtw89_phy_write32_mask(rtwdev, 0x20fc, BIT(24 + path), 0);
+		rtw89_write_rf(rtwdev, path, 0x10005, BIT(0), 1);
+		rtw89_phy_write32_mask(rtwdev, path ? 0x4a9c : 0x4730,
+				       BIT(31), 1);
+
+		for (i = 0; i < ARRAY_SIZE(bb_regs); i++)
+			rtw89_phy_write32(rtwdev, bb_regs[i], bb_saved[i]);
+		for (i = 0; i < ARRAY_SIZE(rf_regs); i++)
+			rtw89_write_rf(rtwdev, path, rf_regs[i], RFREG_MASK,
+				       rf_saved[i]);
+		rtw89_write_rf(rtwdev, path, RR_MOD, RR_MOD_MASK, RR_MOD_V_RX);
+		rtw89_write_rf(rtwdev, path, RR_RSV1, RFREG_MASK, 1);
+	}
+}
+
+void rtw8192xb_set_rxbb_bw(struct rtw89_dev *rtwdev, enum rtw89_bandwidth bw,
+			   enum rtw89_phy_idx phy_idx)
+{
+	u32 val;
+	u8 path;
+
+	switch (bw) {
+	case RTW89_CHANNEL_WIDTH_20:
+	case RTW89_CHANNEL_WIDTH_10:
+	case RTW89_CHANNEL_WIDTH_5:
+		val = 0x1b;
+		break;
+	case RTW89_CHANNEL_WIDTH_40:
+		val = 0x13;
+		break;
+	case RTW89_CHANNEL_WIDTH_80:
+		val = 0x0b;
+		break;
+	case RTW89_CHANNEL_WIDTH_160:
+		val = 0x03;
+		break;
+	default:
+		val = 0x1b;
+		break;
+	}
+
+	for (path = RF_PATH_A; path < RF_PATH_NUM_8192XB; path++) {
+		if (rtwdev->dbcc_en && phy_idx == RTW89_PHY_0 && path == RF_PATH_B)
+			continue;
+		if (rtwdev->dbcc_en && phy_idx == RTW89_PHY_1 && path == RF_PATH_A)
+			continue;
+
+		rtw89_write_rf(rtwdev, path, 0xee, BIT(2), 0x1);
+		rtw89_write_rf(rtwdev, path, 0x33, GENMASK(4, 0), 0x0a);
+		rtw89_write_rf(rtwdev, path, 0x3f, GENMASK(5, 0), val);
+		rtw89_write_rf(rtwdev, path, 0xee, BIT(2), 0x0);
+	}
+}
+
+void rtw8192xb_txgapk_init(struct rtw89_dev *rtwdev)
+{
+	rtw89_write_rf(rtwdev, RF_PATH_A, 0x10055, BIT(19), 0x0);
+	rtw89_write_rf(rtwdev, RF_PATH_B, 0x10055, BIT(19), 0x0);
+}
+
+void rtw8192xb_txgapk(struct rtw89_dev *rtwdev, enum rtw89_phy_idx phy_idx)
+{
+	if (rtwdev->efuse.rfe_type > 50)
+		return;
+
+	rtw8192xb_txgapk_init(rtwdev);
+}
+
+static void rtw8192xb_tssi_disable(struct rtw89_dev *rtwdev)
+{
+	rtw89_phy_write32_mask(rtwdev, 0x5820, BIT(31), 0x0);
+	rtw89_phy_write32_mask(rtwdev, 0x5818, BIT(28), 0x0);
+	rtw89_phy_write32_mask(rtwdev, 0x58e4, BIT(14), 0x1);
+
+	rtw89_phy_write32_mask(rtwdev, 0x7820, BIT(31), 0x0);
+	rtw89_phy_write32_mask(rtwdev, 0x7818, BIT(28), 0x0);
+	rtw89_phy_write32_mask(rtwdev, 0x78e4, BIT(14), 0x1);
+
+	rtwdev->is_tssi_mode[RF_PATH_A] = false;
+	rtwdev->is_tssi_mode[RF_PATH_B] = false;
+}
+
+static void rtw8192xb_tssi_set_sys(struct rtw89_dev *rtwdev,
+				   enum rtw89_rf_path path)
+{
+	rtw89_phy_write32_mask(rtwdev, 0x12bc, 0x000ffff0, 0xb5b5);
+	rtw89_phy_write32_mask(rtwdev, 0x32bc, 0x000ffff0, 0xb5b5);
+	rtw89_phy_write32_mask(rtwdev, 0x0300, 0xff000000, 0x16);
+	rtw89_phy_write32_mask(rtwdev, 0x0304, 0x0000ffff, 0x1f19);
+	rtw89_phy_write32_mask(rtwdev, 0x0308, 0xff000000, 0x1c);
+	rtw89_phy_write32_mask(rtwdev, 0x0314, 0xffff0000, 0x2041);
+	rtw89_phy_write32(rtwdev, 0x0318, 0x20012041);
+	rtw89_phy_write32_mask(rtwdev, 0x0324, 0xffff0000, 0x2001);
+	rtw89_phy_write32_mask(rtwdev, 0x0020, 0x00006000, 0x3);
+	rtw89_phy_write32_mask(rtwdev, 0x0024, 0x00006000, 0x3);
+	rtw89_phy_write32_mask(rtwdev, 0x0704, 0xffff0000, 0x601e);
+	rtw89_phy_write32_mask(rtwdev, 0x2704, 0xffff0000, 0x601e);
+	rtw89_phy_write32_mask(rtwdev, 0x0700, 0xf0000000, 0x4);
+	rtw89_phy_write32_mask(rtwdev, 0x2700, 0xf0000000, 0x4);
+	rtw89_phy_write32_mask(rtwdev, 0x0650, 0x3c000000, 0x0);
+	rtw89_phy_write32_mask(rtwdev, 0x2650, 0x3c000000, 0x0);
+
+	if (path == RF_PATH_A) {
+		rtw89_phy_write32_mask(rtwdev, 0x120c, 0x000000ff, 0x33);
+		rtw89_phy_write32_mask(rtwdev, 0x12c0, 0x0ff00000, 0x33);
+		rtw89_phy_write32_mask(rtwdev, 0x58f8, BIT(30), 0x1);
+	} else {
+		rtw89_phy_write32_mask(rtwdev, 0x320c, 0x000000ff, 0x33);
+		rtw89_phy_write32_mask(rtwdev, 0x32c0, 0x0ff00000, 0x33);
+		rtw89_phy_write32_mask(rtwdev, 0x78f8, BIT(30), 0x1);
+	}
+}
+
+static void rtw8192xb_tssi_ini_txpwr_ctrl_bb(struct rtw89_dev *rtwdev,
+					     enum rtw89_rf_path path)
+{
+	bool is_ifem = !rtw8192xb_rfk_is_efem(rtwdev);
+	u32 p13 = path << 13;
+
+	rtw89_phy_write32_mask(rtwdev, 0x566c, BIT(12), 0x0);
+	rtw89_phy_write32(rtwdev, 0x5800 + p13, 0x003f807f);
+	rtw89_phy_write32_mask(rtwdev, 0x580c + p13, 0x0000007f, 0x40);
+	rtw89_phy_write32_mask(rtwdev, 0x580c + p13, 0x0fffff00, 0x00040);
+	rtw89_phy_write32(rtwdev, 0x5810 + p13, 0x59010000);
+
+	if (is_ifem) {
+		rtw89_phy_write32_mask(rtwdev, 0x5814 + p13, 0x01ffffff, 0x026d000);
+		rtw89_phy_write32_mask(rtwdev, 0x5814 + p13, 0xf8000000, 0x00);
+	}
+
+	rtw89_phy_write32(rtwdev, 0x5818 + p13, 0x002c1800);
+
+	if (is_ifem)
+		rtw89_phy_write32_mask(rtwdev, 0x581c + p13, 0x3fffffff, 0x3dc80280);
+
+	rtw89_phy_write32(rtwdev, 0x5820 + p13, 0x00000080);
+	rtw89_phy_write32_mask(rtwdev, 0x58e8 + p13, 0x0000003f, 0x03);
+
+	if (is_ifem) {
+		rtw89_phy_write32_mask(rtwdev, 0x580c + p13, BIT(28), 0x1);
+		rtw89_phy_write32_mask(rtwdev, 0x580c + p13, BIT(30), 0x1);
+		rtw89_phy_write32_mask(rtwdev, 0x5834 + p13, 0x3fffffff, 0x000115f2);
+		rtw89_phy_write32_mask(rtwdev, 0x5838 + p13, 0x7fffffff, 0x0000121);
+		rtw89_phy_write32_mask(rtwdev, 0x5854 + p13, 0x3fffffff, 0x000115f2);
+		rtw89_phy_write32_mask(rtwdev, 0x5858 + p13, 0x7fffffff, 0x0000121);
+	}
+
+	rtw89_phy_write32_mask(rtwdev, 0x5860 + p13, BIT(31), 0x0);
+	rtw89_phy_write32_mask(rtwdev, 0x5864 + p13, 0x07ffffff, 0x00801ff);
+	rtw89_phy_write32(rtwdev, 0x5898 + p13, 0x00000000);
+	rtw89_phy_write32(rtwdev, 0x589c + p13, 0x00000000);
+	rtw89_phy_write32_mask(rtwdev, 0x58a4 + p13, 0x000000ff, 0x16);
+	rtw89_phy_write32(rtwdev, 0x58b0 + p13, 0x00000000);
+	rtw89_phy_write32_mask(rtwdev, 0x58b4 + p13, 0x7fffffff, 0x0a002000);
+	rtw89_phy_write32_mask(rtwdev, 0x58b8 + p13, 0x7fffffff, 0x00007628);
+	rtw89_phy_write32_mask(rtwdev, 0x58bc + p13, 0x07ffffff, 0x7f7807f);
+	rtw89_phy_write32_mask(rtwdev, 0x58c0 + p13, 0xfffe0000, 0x003f);
+	rtw89_phy_write32(rtwdev, 0x58c4 + p13, 0x0003ffff);
+	rtw89_phy_write32_mask(rtwdev, 0x58c8 + p13, 0x00ffffff, 0x000000);
+	rtw89_phy_write32_mask(rtwdev, 0x58c8 + p13, 0xf0000000, 0x0);
+	rtw89_phy_write32(rtwdev, 0x58cc + p13, 0x00000000);
+	rtw89_phy_write32_mask(rtwdev, 0x58d0 + p13, 0x07ffffff, 0x2008101);
+	rtw89_phy_write32_mask(rtwdev, 0x58d4 + p13, 0x000000ff, 0x00);
+	rtw89_phy_write32_mask(rtwdev, 0x58d4 + p13, 0x0003fe00, 0x0ff);
+	rtw89_phy_write32_mask(rtwdev, 0x58d4 + p13, 0x07fc0000, 0x100);
+
+	if (is_ifem)
+		rtw89_phy_write32(rtwdev, 0x58d8 + p13, 0x8008016c);
+
+	rtw89_phy_write32_mask(rtwdev, 0x58dc + p13, 0x0001ffff, 0x0807f);
+	rtw89_phy_write32_mask(rtwdev, 0x58dc + p13, 0xfff00000, 0x800);
+	rtw89_phy_write32_mask(rtwdev, 0x58f0 + p13, 0x0003ffff, 0x001ff);
+	rtw89_phy_write32_mask(rtwdev, 0x58f4 + p13, 0x000fffff, 0x000);
+	rtw89_phy_write32_mask(rtwdev, 0x58f8 + p13, 0x000fffff, 0x000);
+}
