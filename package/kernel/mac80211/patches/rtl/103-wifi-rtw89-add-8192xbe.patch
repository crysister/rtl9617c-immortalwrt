From: lyq1996 <lyq123233@163.com>
Subject: [PATCH] wifi: rtw89: add RTL8192XBE support

Add the RTL8192XB PCIe 2.4 GHz chip driven by the access point firmware,
including per-RFE parameter and TX power tables, AP PLE/HFC quotas, RFE
GPIO routing, and RCK/DACK/RX_DCK/TXGAPK/IQK/TSSI/DPK/OP5K RF calibrations.

Signed-off-by: lyq1996 <lyq123233@163.com>
---
Index: backports-7.2/drivers/net/wireless/realtek/rtw89/Kconfig
===================================================================
--- backports-7.2.orig/drivers/net/wireless/realtek/rtw89/Kconfig
+++ backports-7.2/drivers/net/wireless/realtek/rtw89/Kconfig
@@ -163,6 +163,20 @@ config RTW89_8852CU
 
 	  802.11ax USB wireless network (Wi-Fi 6E) adapter
 
+config RTW89_8192XB
+	tristate
+
+config RTW89_8192XBE
+	tristate "Realtek 8192XBE PCI wireless network (Wi-Fi 6) adapter"
+	depends on PCI
+	select RTW89_CORE
+	select RTW89_PCI
+	select RTW89_8192XB
+	help
+	  Select this option will enable support for 8192XBE chipset
+
+	  802.11ax PCIe wireless network (Wi-Fi 6) adapter
+
 config RTW89_8922AE
 	tristate "Realtek 8922AE/8922AE-VS PCI wireless network (Wi-Fi 7) adapter"
 	depends on m
Index: backports-7.2/drivers/net/wireless/realtek/rtw89/Makefile
===================================================================
--- backports-7.2.orig/drivers/net/wireless/realtek/rtw89/Makefile
+++ backports-7.2/drivers/net/wireless/realtek/rtw89/Makefile
@@ -93,6 +93,15 @@ rtw89_8922ae-objs := rtw8922ae.o
 obj-$(CPTCFG_RTW89_8922AU) += rtw89_8922au.o
 rtw89_8922au-objs := rtw8922au.o
 
+obj-$(CPTCFG_RTW89_8192XB) += rtw89_8192xb.o
+rtw89_8192xb-objs := rtw8192xb.o \
+		     rtw8192xb_rfk.o \
+		     rtw8192xb_table.o \
+		     rtw8192xb_table_ap.o
+
+obj-$(CPTCFG_RTW89_8192XBE) += rtw89_8192xbe.o
+rtw89_8192xbe-objs := rtw8192xbe.o
+
 rtw89_core-$(CPTCFG_RTW89_DEBUG) += debug.o
 
 obj-$(CPTCFG_RTW89_PCI) += rtw89_pci.o
Index: backports-7.2/drivers/net/wireless/realtek/rtw89/core.h
===================================================================
--- backports-7.2.orig/drivers/net/wireless/realtek/rtw89/core.h
+++ backports-7.2/drivers/net/wireless/realtek/rtw89/core.h
@@ -5552,6 +5552,23 @@ struct rtw89_rx_dck_info {
 	u8 thermal[RF_PATH_MAX];
 };
 
+#define RTW89_OP5K_AVG_THERMAL_NUM 2
+#define RTW89_OP5K_RESET_CNT_DATA 16
+struct rtw89_op5k_info {
+	u32 rst_cnt[RF_PATH_MAX][RTW89_OP5K_RESET_CNT_DATA];
+	u32 rst_cnt_zero[RF_PATH_MAX][2];
+	u32 rst_cnt_final[RF_PATH_MAX];
+	u32 op5k_default[RF_PATH_MAX];
+	u32 op5k_backup[RF_PATH_MAX];
+	u8 thermal_op5k[RF_PATH_MAX];
+	u8 thermal_base_op5k[RF_PATH_MAX];
+	u8 thermal_op5k_avg[RF_PATH_MAX][RTW89_OP5K_AVG_THERMAL_NUM];
+	u8 thermal_op5k_avg_index;
+	bool op5k_progress;
+	bool op5k_ther_chk;
+	bool op5k_set_ch_chk;
+};
+
 struct rtw89_iqk_info {
 	bool lok_cor_fail[RTW89_IQK_CHS_NR][RTW89_IQK_PATH_NR];
 	bool lok_fin_fail[RTW89_IQK_CHS_NR][RTW89_IQK_PATH_NR];
@@ -6532,6 +6549,7 @@ struct rtw89_dev {
 	struct rtw89_rfk_mcc_info rfk_mcc;
 	struct rtw89_lck_info lck;
 	struct rtw89_rx_dck_info rx_dck;
+	struct rtw89_op5k_info op5k;
 	bool is_tssi_mode[RF_PATH_MAX];
 	bool is_bt_iqk_timeout;
 
