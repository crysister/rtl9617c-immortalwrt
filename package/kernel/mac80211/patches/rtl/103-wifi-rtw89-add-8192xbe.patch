+static void rtw8192xb_set_channel_rf(struct rtw89_dev *rtwdev,
+				     const struct rtw89_chan *chan,
+				     enum rtw89_phy_idx phy_idx)
+{
+	static const u32 rf_be[4] = {0x000a0, 0x800a2, 0x800a4, 0x000a5};
+	static const u32 addrs[2] = {0x18, 0x10018};
+	u32 rf_reg18, be;
+	u8 path, bw_val;
+	int bank, i;
+
+	switch (chan->band_width) {
+	case RTW89_CHANNEL_WIDTH_20:
+	case RTW89_CHANNEL_WIDTH_10:
+	case RTW89_CHANNEL_WIDTH_5:
+		bw_val = 0x3;
+		break;
+	case RTW89_CHANNEL_WIDTH_40:
+		bw_val = 0x2;
+		break;
+	case RTW89_CHANNEL_WIDTH_80:
+		bw_val = 0x1;
+		break;
+	default:
+		bw_val = 0x0;
+		break;
+	}
+
+	if (chan->channel <= 4)
+		be = rf_be[0];
+	else if (chan->channel <= 10)
+		be = rf_be[1];
+	else if (chan->channel <= 13)
+		be = rf_be[2];
+	else
+		be = rf_be[3];
+
+	for (path = RF_PATH_A; path <= RF_PATH_B; path++) {
+		if (rtwdev->dbcc_en && phy_idx == RTW89_PHY_0 && path == RF_PATH_B)
+			continue;
+		if (rtwdev->dbcc_en && phy_idx == RTW89_PHY_1 && path == RF_PATH_A)
+			continue;
+
+		for (bank = 0; bank < 2; bank++) {
+			rf_reg18 = rtw89_read_rf(rtwdev, path, addrs[bank], RFREG_MASK);
+			if (rf_reg18 == INV_RF_DATA)
+				continue;
+
+			if (chan->band_type == RTW89_BAND_2G) {
+				rf_reg18 = (rf_reg18 & 0xc1c00) | chan->channel;
+				rtw89_write_rf(rtwdev, path, 0xbe, RFREG_MASK, be);
+				if (path == RF_PATH_A) {
+					for (i = 0; i < 30; i++) {
+						if (rtw89_read_rf(rtwdev, path, 0xbe,
+								  RFREG_MASK) == be)
+							break;
+						udelay(5);
+						rtw89_write_rf(rtwdev, path, 0xbe,
+							       RFREG_MASK, be);
+					}
+				}
+				udelay(5);
+			} else {
+				rf_reg18 &= ~(0x3e3ff | BIT(11) | BIT(10));
+				rf_reg18 |= chan->channel;
+				if (chan->band_type == RTW89_BAND_5G)
+					rf_reg18 |= BIT(16) | BIT(8);
+				else if (chan->band_type == RTW89_BAND_6G)
+					rf_reg18 |= BIT(17) | BIT(16);
+			}
+
+			rtw89_write_rf(rtwdev, path, addrs[bank], RFREG_MASK, rf_reg18);
+			udelay(100);
+		}
+
+		for (bank = 0; bank < 2; bank++) {
+			rf_reg18 = rtw89_read_rf(rtwdev, path, addrs[bank], RFREG_MASK);
+			if (rf_reg18 == INV_RF_DATA)
+				continue;
+			rf_reg18 &= ~GENMASK(11, 10);
+			rf_reg18 |= FIELD_PREP(GENMASK(11, 10), bw_val);
+			rtw89_write_rf(rtwdev, path, addrs[bank], RFREG_MASK, rf_reg18);
+		}
+	}
+
+	rtw8192xb_set_rxbb_bw(rtwdev, chan->band_width, phy_idx);
+	rtw8192xb_op5k_bw_setting(rtwdev);
+}
