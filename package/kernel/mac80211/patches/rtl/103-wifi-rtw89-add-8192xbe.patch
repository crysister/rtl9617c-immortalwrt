+static void rtw8192xb_tssi_set_tmeter_tbl(struct rtw89_dev *rtwdev,
+					  enum rtw89_rf_path path,
+					  const struct rtw89_chan *chan)
+{
+	const struct rtw89_phy_rfe_table_set *set = rtw89_phy_find_rfe_tables(rtwdev);
+	const struct rtw89_txpwr_track_cfg *trk_cfg =
+		(set && set->trk_cfg) ? set->trk_cfg : &rtw89_8192xb_trk_cfg;
+	struct rtw89_tssi_info *tssi_info = &rtwdev->tssi;
+	const s8 *thm_up;
+	const s8 *thm_down;
+	s8 thm_ofst[64] = {0};
+	u32 p13 = path << 13;
+	u8 thermal;
+	u32 tmp;
+	int i, j;
+
+	switch (chan->subband_type) {
+	case RTW89_CH_5G_BAND_1:
+		thm_up = path == RF_PATH_A ? trk_cfg->delta_swingidx_5ga_p[0] :
+					     trk_cfg->delta_swingidx_5gb_p[0];
+		thm_down = path == RF_PATH_A ? trk_cfg->delta_swingidx_5ga_n[0] :
+					       trk_cfg->delta_swingidx_5gb_n[0];
+		break;
+	case RTW89_CH_5G_BAND_3:
+		thm_up = path == RF_PATH_A ? trk_cfg->delta_swingidx_5ga_p[1] :
+					     trk_cfg->delta_swingidx_5gb_p[1];
+		thm_down = path == RF_PATH_A ? trk_cfg->delta_swingidx_5ga_n[1] :
+					       trk_cfg->delta_swingidx_5gb_n[1];
+		break;
+	case RTW89_CH_5G_BAND_4:
+		thm_up = path == RF_PATH_A ? trk_cfg->delta_swingidx_5ga_p[2] :
+					     trk_cfg->delta_swingidx_5gb_p[2];
+		thm_down = path == RF_PATH_A ? trk_cfg->delta_swingidx_5ga_n[2] :
+					       trk_cfg->delta_swingidx_5gb_n[2];
+		break;
+	case RTW89_CH_2G:
+	default:
+		thm_up = path == RF_PATH_A ? trk_cfg->delta_swingidx_2ga_p :
+					     trk_cfg->delta_swingidx_2gb_p;
+		thm_down = path == RF_PATH_A ? trk_cfg->delta_swingidx_2ga_n :
+					       trk_cfg->delta_swingidx_2gb_n;
+		break;
+	}
+
+	thermal = tssi_info->thermal[path];
+
+	rtw89_phy_write32_mask(rtwdev, 0x5810 + p13, BIT(16), 0x0);
+	rtw89_phy_write32_mask(rtwdev, 0x5810 + p13, BIT(24), 0x1);
+
+	if (thermal == 0xff) {
+		rtw89_phy_write32_mask(rtwdev, 0x5810 + p13, 0x0000fc00, 32);
+		rtw89_phy_write32_mask(rtwdev, 0x5864 + p13, 0x03f00000, 32);
+
+		for (i = 0; i < 64; i += 4)
+			rtw89_phy_write32(rtwdev, 0x5c00 + p13 + i, 0x0);
+	} else {
+		rtw89_phy_write32_mask(rtwdev, 0x5810 + p13, 0x0000fc00,
+				       thermal & 0x3f);
+		rtw89_phy_write32_mask(rtwdev, 0x5864 + p13, 0x03f00000,
+				       thermal & 0x3f);
+
+		i = 0;
+		for (j = 0; j < 32; j++) {
+			if (i < DELTA_SWINGIDX_SIZE)
+				thm_ofst[j] = -thm_down[i++];
+			else
+				thm_ofst[j] = -thm_down[DELTA_SWINGIDX_SIZE - 1];
+		}
+
+		i = 1;
+		for (j = 63; j >= 32; j--) {
+			if (i < DELTA_SWINGIDX_SIZE)
+				thm_ofst[j] = thm_up[i++];
+			else
+				thm_ofst[j] = thm_up[DELTA_SWINGIDX_SIZE - 1];
+		}
+
+		for (i = 0; i < 64; i += 4) {
+			tmp = (thm_ofst[i] & 0xff) |
+			      ((thm_ofst[i + 1] & 0xff) << 8) |
+			      ((thm_ofst[i + 2] & 0xff) << 16) |
+			      ((thm_ofst[i + 3] & 0xff) << 24);
+			rtw89_phy_write32(rtwdev, 0x5c00 + p13 + i, tmp);
+		}
+	}
+
+	rtw89_phy_write32_mask(rtwdev, 0x5864 + p13, BIT(26), 0x1);
+	rtw89_phy_write32_mask(rtwdev, 0x5864 + p13, BIT(26), 0x0);
+}
+
+static void rtw8192xb_tssi_slope_cal_org(struct rtw89_dev *rtwdev,
+					 enum rtw89_rf_path path)
+{
+	u32 p13 = path << 13;
+
+	rtw89_phy_write32_mask(rtwdev, 0x5608 + p13, 0x07ffffff, 0x00201008);
+	rtw89_phy_write32_mask(rtwdev, 0x560c + p13, 0x07ffffff, 0x00201008);
+	rtw89_phy_write32_mask(rtwdev, 0x5610 + p13, 0x07ffffff, 0x00201008);
+	rtw89_phy_write32_mask(rtwdev, 0x5614 + p13, 0x07ffffff, 0x00201008);
+	rtw89_phy_write32_mask(rtwdev, 0x5618 + p13, 0x07ffffff, 0x00201008);
+	rtw89_phy_write32_mask(rtwdev, 0x561c + p13, 0x000001ff, 0x00000008);
+	rtw89_phy_write32_mask(rtwdev, 0x561c + p13, 0xffff0000, 0x00000808);
+	rtw89_phy_write32(rtwdev, 0x5620 + p13, 0x08080808);
+	rtw89_phy_write32(rtwdev, 0x5624 + p13, 0x08080808);
+	rtw89_phy_write32(rtwdev, 0x5628 + p13, 0x08080808);
+	rtw89_phy_write32_mask(rtwdev, 0x562c + p13, 0x0000ffff, 0x00000808);
+	rtw89_phy_write32_mask(rtwdev, 0x581c + p13, BIT(20), 0x0);
+}
