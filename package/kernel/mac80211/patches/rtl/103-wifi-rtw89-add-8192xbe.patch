+static void rtw8192xb_tssi_set_alignment_default(struct rtw89_dev *rtwdev,
+						 enum rtw89_rf_path path)
+{
+	bool is_ifem = !rtw8192xb_rfk_is_efem(rtwdev);
+	u32 p13 = path << 13;
+
+	rtw89_phy_write32_mask(rtwdev, 0x5604 + p13, BIT(31), 0x1);
+	rtw89_phy_write32_mask(rtwdev, 0x5600 + p13, 0x3fffffff, 0x00000000);
+	rtw89_phy_write32_mask(rtwdev, 0x5604 + p13, 0x003fffff, 0x002d2721);
+	rtw89_phy_write32_mask(rtwdev, 0x5630 + p13, 0x3fffffff, 0x00000000);
+	rtw89_phy_write32_mask(rtwdev, 0x5634 + p13, 0x000003ff, 0x000);
+
+	if (is_ifem) {
+		u32 v0 = path == RF_PATH_A ? 0x006 : 0x005;
+		u32 v1 = path == RF_PATH_A ? 0x01e : 0x01d;
+		u32 v2 = path == RF_PATH_A ? 0x02c : 0x02b;
+		u32 v3 = path == RF_PATH_A ? 0x09b : 0x0a0;
+
+		rtw89_phy_write32_mask(rtwdev, 0x5634 + p13, 0x000ffc00, v0);
+		rtw89_phy_write32_mask(rtwdev, 0x5634 + p13, 0x3ff00000, v1);
+		rtw89_phy_write32_mask(rtwdev, 0x5638 + p13, 0x000003ff, v2);
+		rtw89_phy_write32_mask(rtwdev, 0x5638 + p13, 0x000ffc00, v3);
+		rtw89_phy_write32_mask(rtwdev, 0x563c + p13, 0x3fffffff, 0x0);
+		rtw89_phy_write32_mask(rtwdev, 0x5640 + p13, 0x000003ff, 0x0);
+		rtw89_phy_write32_mask(rtwdev, 0x5640 + p13, 0x000ffc00, v0);
+		rtw89_phy_write32_mask(rtwdev, 0x5640 + p13, 0x3ff00000, v1);
+		rtw89_phy_write32_mask(rtwdev, 0x5644 + p13, 0x000003ff, v2);
+		rtw89_phy_write32_mask(rtwdev, 0x5644 + p13, 0x000ffc00, v3);
+	} else {
+		rtw89_phy_write32_mask(rtwdev, 0x5634 + p13, 0x000ffc00, 0x0);
+		rtw89_phy_write32_mask(rtwdev, 0x5634 + p13, 0x3ff00000, 0x0);
+		rtw89_phy_write32_mask(rtwdev, 0x5638 + p13, 0x000003ff, 0x0);
+		rtw89_phy_write32_mask(rtwdev, 0x5638 + p13, 0x000ffc00, 0x0);
+		rtw89_phy_write32_mask(rtwdev, 0x563c + p13, 0x3fffffff, 0x0);
+		rtw89_phy_write32_mask(rtwdev, 0x5640 + p13, 0x000003ff, 0x0);
+		rtw89_phy_write32_mask(rtwdev, 0x5640 + p13, 0x000ffc00, 0x0);
+		rtw89_phy_write32_mask(rtwdev, 0x5640 + p13, 0x3ff00000, 0x0);
+		rtw89_phy_write32_mask(rtwdev, 0x5644 + p13, 0x000003ff, 0x0);
+		rtw89_phy_write32_mask(rtwdev, 0x5644 + p13, 0x000ffc00, 0x0);
+	}
+}
+
+static void rtw8192xb_tssi_set_slope(struct rtw89_dev *rtwdev,
+				     enum rtw89_rf_path path)
+{
+	static const u32 slope_regs[] = {
+		0x5834, 0x5854, 0x5824, 0x582c,
+		0x583c, 0x5844, 0x584c, 0x585c,
+	};
+	bool is_efem = rtw8192xb_rfk_is_efem(rtwdev);
+	u8 rfe_type = rtwdev->efuse.rfe_type;
+	u32 p13 = path << 13;
+	int i;
+
+	rtw89_phy_write32_mask(rtwdev, 0x5820 + p13, BIT(31), 0x0);
+
+	if (is_efem) {
+		if (rfe_type == 51 || rfe_type == 53 || rfe_type == 55)
+			rtw89_phy_write32_mask(rtwdev, 0x5820 + p13, BIT(30), 0x1);
+		else
+			rtw89_phy_write32_mask(rtwdev, 0x5820 + p13, BIT(30), 0x0);
+	}
+
+	rtw89_phy_write32_mask(rtwdev, 0x5818 + p13, BIT(28), 0x0);
+	rtw89_phy_write32_mask(rtwdev, 0x5814 + p13, BIT(11), 0x1);
+	rtw89_phy_write32_mask(rtwdev, 0x581c + p13, BIT(29), 0x1);
+	rtw89_phy_write32_mask(rtwdev, 0x58e8 + p13, 0x0000003f, 0x0f);
+	rtw89_phy_write32_mask(rtwdev, 0x581c + p13, 0x000003ff, 0x280);
+	rtw89_phy_write32_mask(rtwdev, 0x581c + p13, 0x000ffc00, 0x200);
+	rtw89_phy_write32_mask(rtwdev, 0x58b8 + p13, 0x007f0000, 0x00);
+	rtw89_phy_write32_mask(rtwdev, 0x58b8 + p13, 0x7f000000, 0x00);
+	rtw89_phy_write32_mask(rtwdev, 0x58b4 + p13, 0x7f000000, 0x0a);
+	rtw89_phy_write32_mask(rtwdev, 0x58b8 + p13, 0x0000007f, 0x28);
+	rtw89_phy_write32_mask(rtwdev, 0x58b8 + p13, 0x00007f00, 0x76);
+	rtw89_phy_write32_mask(rtwdev, 0x5810 + p13, BIT(29), 0x0);
+	rtw89_phy_write32_mask(rtwdev, 0x5814 + p13, BIT(29), 0x1);
+
+	if (!is_efem) {
+		rtw89_phy_write32_mask(rtwdev, 0x580c + p13, BIT(28), 0x1);
+		rtw89_phy_write32_mask(rtwdev, 0x580c + p13, BIT(30), 0x1);
+		for (i = 0; i < ARRAY_SIZE(slope_regs); i++) {
+			u32 r0 = slope_regs[i] + p13;
+			u32 r1 = r0 + 4;
+
+			rtw89_phy_write32_mask(rtwdev, r0, 0x0003ffff, 0x115f2);
+			rtw89_phy_write32_mask(rtwdev, r0, 0x3ffc0000, 0x000);
+			rtw89_phy_write32_mask(rtwdev, r1, 0x00000fff, 0x121);
+			rtw89_phy_write32_mask(rtwdev, r1, 0x003ff000, 0x000);
+		}
+	} else {
+		rtw89_phy_write32_mask(rtwdev, 0x580c + p13, BIT(28), 0x0);
+		rtw89_phy_write32_mask(rtwdev, 0x580c + p13, BIT(30), 0x0);
+	}
+}
+
+static void rtw8192xb_tssi_run_slope(struct rtw89_dev *rtwdev,
+				     enum rtw89_rf_path path)
+{
+	u32 p13 = path << 13;
+
+	rtw89_phy_write32_mask(rtwdev, 0x5820 + p13, BIT(31), 0x0);
+	rtw89_phy_write32_mask(rtwdev, 0x5820 + p13, BIT(31), 0x1);
+}
+
+static void rtw8192xb_tssi_set_tssi_track(struct rtw89_dev *rtwdev,
+					  enum rtw89_rf_path path)
+{
+	u32 p13 = path << 13;
+
+	rtw89_phy_write32_mask(rtwdev, 0x5820 + p13, BIT(31), 0x0);
+	rtw89_phy_write32_mask(rtwdev, 0x5818 + p13, BIT(28), 0x0);
+	rtw89_phy_write32_mask(rtwdev, 0x5814 + p13, BIT(11), 0x0);
+	rtw89_phy_write32_mask(rtwdev, 0x581c + p13, BIT(29), 0x1);
+	rtw89_phy_write32_mask(rtwdev, 0x5864 + p13, 0x000003ff, 0x1ff);
+	rtw89_phy_write32_mask(rtwdev, 0x5864 + p13, 0x000ffc00, 0x200);
+	rtw89_phy_write32_mask(rtwdev, 0x5820 + p13, 0x00000fff, 0x080);
+	rtw89_phy_write32_mask(rtwdev, 0x5814 + p13, BIT(24), 0x0);
+}
+
+static void rtw8192xb_tssi_set_txagc_offset_mv_avg(struct rtw89_dev *rtwdev,
+						   enum rtw89_rf_path path)
+{
+	bool is_efem = rtw8192xb_rfk_is_efem(rtwdev);
+	u32 p13 = path << 13;
+
+	rtw89_phy_write32_mask(rtwdev, 0x58e4 + p13, 0x00003800, 0x1);
+	rtw89_phy_write32_mask(rtwdev, 0x58e4 + p13, 0x00004000, 0x0);
+	rtw89_phy_write32_mask(rtwdev, 0x58e4 + p13, 0x00008000, 0x1);
+	rtw89_phy_write32_mask(rtwdev, 0x58e4 + p13, 0x000f0000, 0x0);
+	rtw89_phy_write32_mask(rtwdev, 0x58e8 + p13, 0x0000003f,
+			       is_efem ? 0x04 : 0x07);
+}
+
+static void rtw8192xb_tssi_enable(struct rtw89_dev *rtwdev)
+{
+	u8 path;
+
+	for (path = RF_PATH_A; path < RF_PATH_NUM_8192XB; path++) {
+		u32 p13 = path << 13;
+
+		rtw8192xb_tssi_set_tssi_track(rtwdev, path);
+		rtw8192xb_tssi_set_txagc_offset_mv_avg(rtwdev, path);
+
+		rtw89_phy_write32_mask(rtwdev, 0x58e4 + p13, BIT(14), 0x0);
+		rtw89_phy_write32_mask(rtwdev, 0x5820 + p13, BIT(31), 0x0);
+		rtw89_phy_write32_mask(rtwdev, 0x5820 + p13, BIT(31), 0x1);
+		rtw89_write_rf(rtwdev, path, 0x10055, BIT(7), 0x1);
+		rtw89_phy_write32_mask(rtwdev, 0x5818 + p13, BIT(28), 0x1);
+		rtwdev->is_tssi_mode[path] = true;
+	}
+}
