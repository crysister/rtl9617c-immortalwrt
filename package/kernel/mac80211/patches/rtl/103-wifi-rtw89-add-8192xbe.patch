+static void rtw8192xb_rfe_gpio(struct rtw89_dev *rtwdev)
+{
+	u8 rfe_type = rtwdev->efuse.rfe_type;
+	bool efem = rfe_type == 53 || rfe_type == 54 || rfe_type == 94;
+
+	if (efem) {
+		rtw89_phy_route_rfe_gpio(rtwdev, RF_PATH_A, 11, false,
+					 RFE_SEL0_SRC_PAPE_RFM);
+		rtw89_phy_route_rfe_gpio(rtwdev, RF_PATH_A, 7, true,
+					 RFE_SEL0_SRC_TRSW_RFM);
+		rtw89_phy_route_rfe_gpio(rtwdev, RF_PATH_A, 6, true,
+					 RFE_SEL0_SRC_LNAON_RFM);
+
+		rtw89_phy_route_rfe_gpio(rtwdev, RF_PATH_B, 1, false,
+					 RFE_SEL0_SRC_PAPE_RFM);
+		rtw89_phy_route_rfe_gpio(rtwdev, RF_PATH_B, 2, true,
+					 RFE_SEL0_SRC_TRSW_RFM);
+		rtw89_phy_route_rfe_gpio(rtwdev, RF_PATH_B, 3, true,
+					 RFE_SEL0_SRC_LNAON_RFM);
+	} else if (rfe_type == 51 || rfe_type == 52) {
+		rtw89_phy_route_rfe_gpio(rtwdev, RF_PATH_A, 6, false,
+					 RFE_SEL0_SRC_LNAON_RFM);
+		rtw89_phy_route_rfe_gpio(rtwdev, RF_PATH_A, 11, false,
+					 RFE_SEL0_SRC_PAPE_RFM);
+
+		rtw89_phy_route_rfe_gpio(rtwdev, RF_PATH_B, 3, false,
+					 RFE_SEL0_SRC_LNAON_RFM);
+		rtw89_phy_route_rfe_gpio(rtwdev, RF_PATH_B, 1, false,
+					 RFE_SEL0_SRC_PAPE_RFM);
+	}
+
+	if (rfe_type > 50)
+		rtw89_phy_route_rfe_gpio(rtwdev, RF_PATH_A, 12, true,
+					 RFE_SEL0_SRC_ZERO);
+}
