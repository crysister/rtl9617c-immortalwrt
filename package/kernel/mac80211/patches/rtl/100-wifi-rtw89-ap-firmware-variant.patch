+void rtw89_core_update_txpwr_limit(struct rtw89_dev *rtwdev)
+{
+	struct rtw89_vif_link *rtwvif_link;
+	struct ieee80211_bss_conf *bss_conf;
+	struct rtw89_vif *rtwvif;
+	unsigned int link_id;
+	int power = INT_MAX;
+
+	rcu_read_lock();
+	rtw89_for_each_rtwvif(rtwdev, rtwvif) {
+		rtw89_vif_for_each_link(rtwvif, rtwvif_link, link_id) {
+			bss_conf = rtw89_vif_rcu_dereference_link(rtwvif_link, false);
+			if (bss_conf->txpower != INT_MIN)
+				power = min(power, bss_conf->txpower);
+		}
+	}
+	rcu_read_unlock();
+
+	if (power == INT_MAX) {
+		if (!rtwdev->ops->assign_vif_chanctx &&
+		    rtwdev->hw->conf.chandef.chan &&
+		    rtwdev->hw->conf.power_level != INT_MIN)
+			power = rtwdev->hw->conf.power_level;
+		else
+			power = INT_MIN;
+	}
+
+	rtwdev->txpower_dbm = power;
+}
+
+void rtw89_core_recalc_txpwr(struct rtw89_dev *rtwdev)
+{
+	int prev = rtwdev->txpower_dbm;
+
+	rtw89_core_update_txpwr_limit(rtwdev);
+	if (rtwdev->txpower_dbm != prev)
+		rtw89_core_set_chip_txpwr(rtwdev);
+}
