+static struct rtw89_chan_survey *
+rtw89_phy_survey_find(struct rtw89_dev *rtwdev, struct rtw89_bb_ctx *bb,
+		      const struct ieee80211_channel *chan)
+{
+	struct rtw89_env_monitor_info *env = &bb->env_monitor;
+	struct ieee80211_supported_band *sband;
+	enum rtw89_band hw_band;
+	u8 i;
+
+	if (!chan)
+		return NULL;
+
+	sband = rtwdev->hw->wiphy->bands[chan->band];
+	if (!sband)
+		return NULL;
+
+	hw_band = rtw89_nl80211_to_hw_band(chan->band);
+	if (!env->survey[hw_band])
+		return NULL;
+
+	for (i = 0; i < sband->n_channels; i++) {
+		if (&sband->channels[i] == chan ||
+		    sband->channels[i].center_freq == chan->center_freq)
+			return &env->survey[hw_band][i];
+	}
+
+	return NULL;
+}
+
+static void rtw89_phy_survey_record(struct rtw89_dev *rtwdev,
+				    struct rtw89_bb_ctx *bb,
+				    const struct ieee80211_channel *chan)
+{
+	struct rtw89_env_monitor_info *env = &bb->env_monitor;
+	struct rtw89_chan_survey *survey;
+	u64 time_ms, busy_ms, rx_ms, tx_ms;
+	u32 unit_us, total_ticks, rx_ticks, tx_ticks, busy_ticks;
+
+	survey = rtw89_phy_survey_find(rtwdev, bb, chan);
+	if (!survey || !env->ccx_period)
+		return;
+
+	unit_us = 4 << env->ccx_unit_idx;
+	total_ticks = env->ccx_period;
+	tx_ticks = env->ifs_clm_tx;
+	rx_ticks = (u32)env->ifs_clm_cckcca_excl_fa +
+		   env->ifs_clm_ofdmcca_excl_fa +
+		   env->ifs_clm_cckfa +
+		   env->ifs_clm_ofdmfa;
+	busy_ticks = min_t(u32, total_ticks,
+			   tx_ticks + rx_ticks + env->ifs_clm_edcca_excl_cca);
+
+	time_ms = DIV_ROUND_CLOSEST_ULL((u64)total_ticks * unit_us, 1000);
+	if (!time_ms)
+		return;
+
+	busy_ms = min_t(u64, time_ms,
+			DIV_ROUND_CLOSEST_ULL((u64)busy_ticks * unit_us, 1000));
+	rx_ms = min_t(u64, time_ms,
+		      DIV_ROUND_CLOSEST_ULL((u64)rx_ticks * unit_us, 1000));
+	tx_ms = min_t(u64, time_ms,
+		      DIV_ROUND_CLOSEST_ULL((u64)tx_ticks * unit_us, 1000));
+
+	survey->time_ms += time_ms;
+	survey->time_busy_ms += busy_ms;
+	survey->time_rx_ms += rx_ms;
+	survey->time_tx_ms += tx_ms;
+	survey->noise = RTW89_NOISE_DEFAULT;
+	survey->filled = true;
+}
+
+void rtw89_phy_survey_reset(struct rtw89_dev *rtwdev)
+{
+	struct ieee80211_supported_band *sband;
+	struct rtw89_bb_ctx *bb;
+	enum rtw89_band hw_band;
+	enum nl80211_band band;
+
+	rtw89_for_each_capab_bb(rtwdev, bb) {
+		struct rtw89_env_monitor_info *env = &bb->env_monitor;
+
+		env->survey_active = false;
+		env->survey_chan = NULL;
+		for (band = 0; band < NUM_NL80211_BANDS; band++) {
+			sband = rtwdev->hw->wiphy->bands[band];
+			if (!sband)
+				continue;
+
+			hw_band = rtw89_nl80211_to_hw_band(band);
+			if (!env->survey[hw_band])
+				continue;
+
+			memset(env->survey[hw_band], 0,
+			       sband->n_channels * sizeof(*env->survey[hw_band]));
+		}
+	}
+}
+
+void rtw89_phy_survey_trigger(struct rtw89_dev *rtwdev, u16 mntr_time_ms)
+{
+	const struct rtw89_phy_gen_def *phy = rtwdev->chip->phy_def;
+	struct ieee80211_conf *conf = &rtwdev->hw->conf;
+	struct rtw89_bb_ctx *bb;
+
+	if (!phy->ccx || !test_bit(RTW89_FLAG_RUNNING, rtwdev->flags))
+		return;
+
+	rtw89_for_each_active_bb(rtwdev, bb) {
+		struct rtw89_env_monitor_info *env = &bb->env_monitor;
+		struct rtw89_ccx_para_info para = {};
+
+		rtw89_phy_ccx_racing_release(rtwdev, bb);
+		para.mntr_time = mntr_time_ms;
+		para.rac_lv = RTW89_RAC_LV_2;
+		para.ifs_clm_app = RTW89_IFS_CLM_BACKGROUND;
+
+		if (rtw89_phy_ifs_clm_set(rtwdev, bb, &para) == 0) {
+			rtw89_phy_ccx_trigger(rtwdev, bb, RTW89_PHY_ENV_MON_IFS_CLM);
+			env->survey_chan = conf->chandef.chan;
+			env->survey_active = true;
+		}
+	}
+}
+
+void rtw89_phy_survey_collect(struct rtw89_dev *rtwdev, bool release)
+{
+	const struct rtw89_phy_gen_def *phy = rtwdev->chip->phy_def;
+	struct rtw89_bb_ctx *bb;
+
+	if (!phy->ccx || !test_bit(RTW89_FLAG_RUNNING, rtwdev->flags))
+		return;
+
+	rtw89_for_each_active_bb(rtwdev, bb) {
+		struct rtw89_env_monitor_info *env = &bb->env_monitor;
+
+		if (env->survey_active && env->survey_chan &&
+		    rtw89_phy_ifs_clm_get_result(rtwdev, bb)) {
+			rtw89_phy_edcca_clm_get_result(rtwdev, bb);
+			rtw89_phy_survey_record(rtwdev, bb, env->survey_chan);
+		}
+
+		env->survey_active = false;
+		env->survey_chan = NULL;
+		if (release)
+			rtw89_phy_ccx_racing_release(rtwdev, bb);
+	}
+}
